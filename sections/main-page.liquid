{%- comment -%} Plain pages (Care, Size and measure, Visit the unit …) use the article layout: 2/8/2, a Light title, 18px body. {%- endcomment -%}
<article class="av-article">
  <div class="av-article__body">
    <h1 class="av-statement av-statement--l">{{ page.title | escape }}</h1>
    <div class="av-body rte">{{ page.content }}</div>
  </div>
</article>

{% schema %}
{
  "name": "t:sections.main-page.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
