{%- comment -%} Story panel: the collection film (the entry's `film`), muted loop with tap-for-sound. Hidden when there is no film. {%- endcomment -%}
{%- assign series = metaobject | default: section.settings.series -%}
{%- if series != blank and series.film.value != blank -%}
<section class="av-series-film av-wrap" data-av-panel="story">
  {% render 'av-video', loop_video: series.film.value, film: series.film.value, poster: series.ensemble_image.value, class: 'av-series-film__video' %}
  <div class="av-film__caption">
    <div class="av-sub av-sub--xs">{{ section.settings.caption | escape }}</div>
    <div class="av-label">{{ section.settings.meta | escape }}</div>
  </div>
</section>
{%- endif -%}
{% schema %}
{ "name": "AV Series film", "settings": [
  { "type": "metaobject", "metaobject_type": "collection_meta", "id": "series", "label": "Collection (only for previewing outside a series page)" },
  { "type": "text", "id": "caption", "label": "Caption", "default": "The collection film — loom, hands, a voice in Tamil" },
  { "type": "text", "id": "meta", "label": "Meta", "default": "≈ 1:30 · subtitled" }
], "presets": [{ "name": "AV Series film" }] }
{% endschema %}
