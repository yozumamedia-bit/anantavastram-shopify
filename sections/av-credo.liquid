<section class="av-credo">
  <div class="av-label">{{ section.settings.label | escape }}</div>
  <p class="av-statement av-statement--credo av-credo__text">{{ section.settings.statement | escape }}</p>
  <span class="av-credo__line"></span>
</section>
{% schema %}
{ "name": "AV Credo", "settings": [
  { "type": "text", "id": "label", "label": "Label", "default": "Handcrafted in Tamil Nadu" },
  { "type": "textarea", "id": "statement", "label": "Statement", "default": "The veshti, embroidered by hand. Designed in our Chennai studio, on handloom cloth. Made in small numbers for authenticity." }
], "presets": [{ "name": "AV Credo" }] }
{% endschema %}
