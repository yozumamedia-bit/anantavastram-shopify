<section class="av-credo">
  <div class="av-label">{{ section.settings.label | escape }}</div>
  <p class="av-statement av-statement--credo av-credo__text">{{ section.settings.statement | escape }}</p>
  <span class="av-credo__line"></span>
</section>
{% schema %}
{ "name": "AV Credo", "settings": [
  { "type": "text", "id": "label", "label": "Label", "default": "The house keeps to this" },
  { "type": "textarea", "id": "statement", "label": "Statement", "default": "Menswear handcrafted in Tamil Nadu, by weavers we name. Everyday and Occasional pieces are held in stock, in limited number. A Commission is made once, for one person." }
], "presets": [{ "name": "AV Credo" }] }
{% endschema %}
