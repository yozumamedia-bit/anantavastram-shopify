{%- if section.blocks.size > 0 -%}
<section class="av-showcase av-reveal">
  {%- comment -%} Three tall stills with numeral captions; a swipe rail on phones (see .av-showcase__rail). {%- endcomment -%}
  <div class="av-showcase__rail av-grid av-grid--3">
    {%- for block in section.blocks -%}
      <figure class="av-showcase__item" {{ block.shopify_attributes }}>
        {% render 'av-media', image: block.settings.image, ratio: '3 / 5.6', sizes: '(min-width: 900px) 33vw, 78vw' %}
        {%- if block.settings.caption != blank -%}<figcaption class="av-showcase__caption">{{ block.settings.caption | escape }}</figcaption>{%- endif -%}
      </figure>
    {%- endfor -%}
  </div>
</section>
{%- endif -%}
{% schema %}
{ "name": "AV Showcase (three)", "max_blocks": 3, "blocks": [ { "type": "image", "name": "Image", "settings": [
  { "type": "image_picker", "id": "image", "label": "Image (tall)" },
  { "type": "text", "id": "caption", "label": "Caption (Roman numeral · name)", "default": "I · [Set]" }
] } ], "presets": [ { "name": "AV Showcase (three)", "blocks": [ { "type": "image", "settings": { "caption": "I · Red set" } }, { "type": "image", "settings": { "caption": "II · Rust set" } }, { "type": "image", "settings": { "caption": "III · Linen set" } } ] } ] }
{% endschema %}
