{%- liquid
  assign show = true
  if section.settings.all_products_only and collection.handle != 'all' and template.suffix != 'products-all'
    assign show = false
  endif
-%}
{%- if show -%}
<section class="av-intro{% if section.settings.open %} av-intro--open{% endif %}">
  <div class="av-stack" style="gap:28px">
    <div class="av-label">{{ section.settings.label | escape }}</div>
    <h1 class="av-statement av-statement--xl">{{ section.settings.statement | escape }}</h1>
  </div>
  <div class="av-stack">
    <div class="av-body{% if section.settings.large_body %} av-body--l{% endif %}">{{ section.settings.text }}</div>
    {%- if section.settings.note != blank -%}<div class="av-body av-body--s" style="color:var(--av-grey-1)">{{ section.settings.note | escape | newline_to_br }}</div>{%- endif -%}
    {%- comment -%}
      A filter tab that points at a tag of /collections/all (e.g. /collections/all/everyday) shows only while some piece
      carries that tag, and the row of tabs shows only when there are two or more: a filter that returns the same pieces
      as All is noise (site review, 4 Nov 2026).
    {%- endcomment -%}
    {%- liquid
      assign live_tags = '|'
      for t in collections.all.all_tags
        assign th = t | handleize
        assign live_tags = live_tags | append: th | append: '|'
      endfor
      assign key_count = 0
      capture keys
        for block in section.blocks
          assign u = block.settings.url
          if u != blank and u contains '/collections/all/'
            assign tag = u | split: '/collections/all/' | last | split: '?' | first | handleize
            assign tag_key = '|' | append: tag | append: '|'
            unless live_tags contains tag_key
              continue
            endunless
          endif
          assign key_count = key_count | plus: 1
          assign is_active = false
          if u != blank and u == request.path
            assign is_active = true
          endif
          assign lbl = block.settings.label | escape
          if u != blank
            echo '<a class="av-label av-label--red'
            if is_active
              echo ' is-active" aria-current="page'
            endif
            echo '" href="' | append: u | append: '" ' | append: block.shopify_attributes | append: '>' | append: lbl | append: '</a>'
          else
            echo '<span class="av-label av-label--red" ' | append: block.shopify_attributes | append: '>' | append: lbl | append: '</span>'
          endif
        endfor
      endcapture
    -%}
    {%- if key_count > 1 -%}<div class="av-intro__keys">{{ keys }}</div>{%- endif -%}
  </div>
</section>
{%- endif -%}
{% schema %}
{ "name": "AV Page intro", "settings": [
  { "type": "checkbox", "id": "all_products_only", "label": "Products page only", "info": "Shows only on /collections/all (the Products page). Leave off everywhere else.", "default": false },
  { "type": "text", "id": "label", "label": "Label", "default": "Collections" },
  { "type": "textarea", "id": "statement", "label": "Statement (General Sans Light)", "default": "Each collection grows from one inspiration." },
  { "type": "richtext", "id": "text", "label": "Paragraph", "default": "<p>A collection is a small set of pieces drawn from one source. Each piece is embroidered in small numbers and held in stock in Chennai.</p>" },
  { "type": "textarea", "id": "note", "label": "Secondary note (About page only)" },
  { "type": "checkbox", "id": "large_body", "label": "Larger paragraph (About)", "default": false },
  { "type": "checkbox", "id": "open", "label": "No bottom rule", "default": false }
], "blocks": [ { "type": "key", "name": "Key word / filter link", "settings": [ { "type": "text", "id": "label", "label": "Label" }, { "type": "url", "id": "url", "label": "Link (optional — makes it a filter tab)" } ] } ],
"presets": [{ "name": "AV Page intro" }] }
{% endschema %}
