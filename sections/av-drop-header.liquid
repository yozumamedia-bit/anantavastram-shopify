{%- comment -%}
  Top of a collection page. When the collection belongs to a series (collection metafield custom.series → a
  collection_meta entry) it is that series' Pieces tab: the shared series header and tabs (snippets/av-series-head.liquid),
  then the shipping line. Otherwise the plain collection intro.
  /collections/all (Shopify's automatic all-products collection) is the Products page: its sections live in this
  template too, keyed on the handle.
{%- endcomment -%}
{%- unless collection.handle == 'all' -%}
{%- assign series = collection.metafields.custom.series.value -%}
{%- if series != blank -%}
  <div class="av-series av-series--pieces">
    {% render 'av-series-head', series: series, series_col: collection, active: 'pieces' %}
    <div class="av-wrap av-series-pieces__intro">
      {%- if section.settings.intro != blank -%}<p class="av-body av-body--s">{{ section.settings.intro | escape }}</p>{%- endif -%}
      {%- comment -%} The shipping line is printed once here; the rows below carry none (the product page has its own accordion). {%- endcomment -%}
      {%- if settings.av_shipping_line != blank -%}<p class="av-body av-body--meta">{{ settings.av_shipping_line | escape }}</p>{%- endif -%}
    </div>
  </div>
{%- else -%}
<section class="av-intro">
  <div class="av-stack" style="gap:28px">
    <div class="av-label">Collection</div>
    <h1 class="av-statement av-statement--xl">{{ collection.title | escape }}</h1>
  </div>
  <div class="av-stack">
    {%- if collection.description != blank -%}<div class="av-body">{{ collection.description }}</div>{%- endif -%}
    {%- if settings.av_shipping_line != blank -%}<div class="av-body av-body--meta">{{ settings.av_shipping_line | escape }}</div>{%- endif -%}
  </div>
</section>
{%- endif -%}
{%- endunless -%}
{% schema %}
{ "name": "AV Collection header", "settings": [
  { "type": "text", "id": "intro", "label": "Line under the tabs (series collections)", "default": "Nothing here is on a shelf. Each piece is woven after you order it, in a numbered edition, and ships with its weaver's name." }
] }
{% endschema %}
