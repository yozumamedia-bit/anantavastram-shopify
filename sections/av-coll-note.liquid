{%- comment -%} Story panel: the designer's note for the collection (the entry's `design_note`). Hidden when the note is empty. {%- endcomment -%}
{%- liquid
  assign meta = nil
  if collection != blank and collection.handle != 'all'
    for m in shop.metaobjects.collection_meta.values
      if m.collection.value.id == collection.id
        assign meta = m
        break
      endif
    endfor
  endif
-%}
{%- if meta != blank and meta.design_note.value != blank -%}
<section class="av-coll-note av-wrap av-section" data-av-panel="story">
  <div class="av-stack" style="gap:12px">
    <div class="av-label">{{ section.settings.label | escape }}</div>
    {%- if section.settings.author != blank -%}<div class="av-body av-body--s">{{ section.settings.author | escape | newline_to_br }}</div>{%- endif -%}
  </div>
  <div class="av-statement av-statement--m av-coll-note__text">{% render 'av-field-text', field: meta.design_note %}</div>
</section>
{%- endif -%}
{% schema %}
{ "name": "AV Collection note", "settings": [
  { "type": "text", "id": "label", "label": "Label", "default": "The design note" },
  { "type": "textarea", "id": "author", "label": "Author line", "default": "Kamalam Moorthy\nChief Designer" }
], "presets": [{ "name": "AV Collection note" }] }
{% endschema %}
