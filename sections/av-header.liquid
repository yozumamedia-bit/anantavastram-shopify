<header class="av-header" id="av-header">
  <div class="av-header__lead">
    <button class="av-header__burger" type="button" aria-label="Open menu" onclick="document.getElementById('av-drawer').showModal()">{% render 'av-icon', name: 'burger' %}</button>
    <a class="av-header__icon" href="{{ routes.search_url }}" aria-label="Search">{% render 'av-icon', name: 'search' %}</a>
  </div>
  <nav class="av-header__nav av-header__nav--left" aria-label="The house">
    {%- if section.settings.menu_house.links.size > 0 -%}
      {%- for link in section.settings.menu_house.links -%}
        <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
      {%- endfor -%}
    {%- else -%}
      {% render 'av-nav-fallback', group: 'house' %}
    {%- endif -%}
  </nav>
  <a class="av-header__home" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">{% render 'av-wordmark', class: 'av-header__wordmark' %}</a>
  <div class="av-header__right">
    <nav class="av-header__nav av-header__nav--right" aria-label="Shop">
      {%- if section.settings.menu_shop.links.size > 0 -%}
        {%- for link in section.settings.menu_shop.links -%}
          <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
        {%- endfor -%}
      {%- else -%}
        {% render 'av-nav-fallback', group: 'shop' %}
      {%- endif -%}
    </nav>
    <div class="av-header__icons">
      <a class="av-header__search" href="{{ routes.search_url }}" aria-label="Search">{% render 'av-icon', name: 'search' %}</a>
      {%- if shop.customer_accounts_enabled -%}
        <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" aria-label="Account">{% render 'av-icon', name: 'account' %}</a>
      {%- endif -%}
      <a href="{{ routes.cart_url }}" id="cart-icon-bubble">{% render 'av-cart-bubble' %}</a>
    </div>
  </div>
</header>

<dialog class="av-drawer" id="av-drawer" aria-label="Menu">
  <button class="av-drawer__close" type="button" aria-label="Close menu" onclick="this.closest('dialog').close()">{% render 'av-icon', name: 'close' %}</button>
  <nav class="av-drawer__group" aria-label="The house">
    {%- if section.settings.menu_house.links.size > 0 -%}
      {%- for link in section.settings.menu_house.links -%}<a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>{%- endfor -%}
    {%- else -%}
      {% render 'av-nav-fallback', group: 'house' %}
    {%- endif -%}
  </nav>
  <nav class="av-drawer__group" aria-label="Shop">
    {%- if section.settings.menu_shop.links.size > 0 -%}
      {%- for link in section.settings.menu_shop.links -%}<a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>{%- endfor -%}
    {%- else -%}
      {% render 'av-nav-fallback', group: 'shop' %}
    {%- endif -%}
  </nav>
</dialog>

{% schema %}
{
  "name": "AV Header",
  "class": "av-header-section",
  "limit": 1,
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "link_list", "id": "menu_house", "label": "Left menu — the house (Stories · Gallery · About)", "info": "Leave empty to use the built-in links." },
    { "type": "link_list", "id": "menu_shop", "label": "Right menu — shop (Collections · Products · Exclusive)", "info": "Leave empty to use the built-in links." }
  ]
}
{% endschema %}
