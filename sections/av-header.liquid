<header class="av-header" id="av-header">
  <div class="av-header__lead">
    <button class="av-header__burger" type="button" aria-label="Open menu" aria-controls="av-drawer">{% render 'av-icon', name: 'burger' %}</button>
    <a class="av-header__icon" href="{{ routes.search_url }}" aria-label="Search">{% render 'av-icon', name: 'search' %}</a>
  </div>
  <nav class="av-header__nav av-header__nav--left" aria-label="The house">
    {%- if section.settings.menu_house.links.size > 0 -%}
      {%- for link in section.settings.menu_house.links -%}{%- if link.type == 'blog_link' and link.object.articles_count == 0 -%}{%- continue -%}{%- endif -%}
        <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
      {%- endfor -%}
    {%- else -%}
      {% render 'av-nav-fallback', group: 'house' %}
    {%- endif -%}
  </nav>
  <a class="av-header__home" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">{% render 'av-wordmark', class: 'av-header__wordmark' %}</a>
  <div class="av-header__right">
    <nav class="av-header__nav av-header__nav--right" aria-label="Shop">
      {%- if section.settings.menu_shop.links.size > 0 -%}
        {%- for link in section.settings.menu_shop.links -%}{%- if link.type == 'blog_link' and link.object.articles_count == 0 -%}{%- continue -%}{%- endif -%}
          <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
        {%- endfor -%}
      {%- else -%}
        {% render 'av-nav-fallback', group: 'shop' %}
      {%- endif -%}
    </nav>
    <div class="av-header__icons">
      <a class="av-header__search" href="{{ routes.search_url }}" aria-label="Search">{% render 'av-icon', name: 'search' %}</a>
      {%- if settings.av_show_account and shop.customer_accounts_enabled -%}
        <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" aria-label="Account">{% render 'av-icon', name: 'account' %}</a>
      {%- endif -%}
      <a href="{{ routes.cart_url }}" id="cart-icon-bubble">{% render 'av-cart-bubble' %}</a>
    </div>
  </div>
</header>

<dialog class="av-drawer" id="av-drawer" aria-label="Menu">
  <button class="av-drawer__close" type="button" aria-label="Close menu">{% render 'av-icon', name: 'close' %}</button>
  <nav class="av-drawer__group" aria-label="The house">
    {%- if section.settings.menu_house.links.size > 0 -%}
      {%- for link in section.settings.menu_house.links -%}{%- if link.type == 'blog_link' and link.object.articles_count == 0 -%}{%- continue -%}{%- endif -%}<a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>{%- endfor -%}
    {%- else -%}
      {% render 'av-nav-fallback', group: 'house' %}
    {%- endif -%}
  </nav>
  <nav class="av-drawer__group" aria-label="Shop">
    {%- if section.settings.menu_shop.links.size > 0 -%}
      {%- for link in section.settings.menu_shop.links -%}{%- if link.type == 'blog_link' and link.object.articles_count == 0 -%}{%- continue -%}{%- endif -%}<a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>{%- endfor -%}
    {%- else -%}
      {% render 'av-nav-fallback', group: 'shop' %}
    {%- endif -%}
  </nav>
  <div class="av-drawer__foot">
    <nav class="av-drawer__more" aria-label="More">
      <a href="{{ routes.search_url }}">Search</a>
      {% render 'av-whatsapp-link', label: 'WhatsApp', class: 'av-drawer__wa' %}
      {%- if pages['contact'].url != blank -%}<a href="{{ pages['contact'].url }}">Write to us</a>{%- endif -%}
      {%- if settings.social_instagram_link != blank -%}<a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener">Instagram</a>{%- endif -%}
    </nav>
    <img class="av-drawer__symbol" src="{{ 'av-symbol-ivory.svg' | asset_url }}" alt="" width="1001" height="674" loading="lazy">
  </div>
</dialog>

{% schema %}
{
  "name": "AV Header",
  "class": "av-header-section",
  "limit": 1,
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "link_list", "id": "menu_house", "label": "Left menu — the house (Stories · Gallery · About)", "info": "Leave empty to use the built-in links." },
    { "type": "link_list", "id": "menu_shop", "label": "Right menu — shop (Collections · Products · Commissions)", "info": "Leave empty to use the built-in links." }
  ]
}
{% endschema %}
