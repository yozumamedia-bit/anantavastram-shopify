{%- comment -%} Password page: flat kumkum, the wordmark, one line, the letter sign-up. The storefront password sits behind a quiet link at the foot. {%- endcomment -%}
<div class="av-password">
  <div class="av-password__main">
    <h1 class="av-password__mark">{% render 'av-wordmark', class: 'av-password__wordmark' %}</h1>
    {%- if section.settings.line != blank -%}
      <p class="av-statement av-password__line">{{ section.settings.line | escape }}</p>
    {%- endif -%}
    {%- if section.settings.show_signup -%}
      {% render 'av-newsletter-form', id: 'password', placeholder: section.settings.news_placeholder, class: 'av-footer__news av-password__news' %}
    {%- endif -%}
  </div>

  <details class="av-password__entry">
    <summary class="av-label">Enter with password</summary>
    {%- form 'storefront_password', class: 'av-footer__news av-password__form' -%}
      <label class="visually-hidden" for="av-password-input">Password</label>
      <input id="av-password-input" type="password" name="password" placeholder="Password" autocomplete="current-password" required{% if form.errors %} aria-invalid="true" aria-describedby="av-password-err"{% endif %}>
      <button type="submit">Enter</button>
      {%- if form.errors -%}<span id="av-password-err" class="av-body--s" role="alert">That password did not work.</span>{%- endif -%}
    {%- endform -%}
  </details>
  <script>var e = document.getElementById('av-password-err'); if (e) e.closest('details').open = true;</script>
</div>

{% schema %}
{
  "name": "AV Password page",
  "limit": 1,
  "settings": [
    { "type": "text", "id": "line", "label": "Line under the wordmark", "default": "The first drop opens at Pongal 2027." },
    { "type": "checkbox", "id": "show_signup", "label": "Show the letter sign-up", "default": true },
    { "type": "text", "id": "news_placeholder", "label": "Sign-up placeholder", "default": "Your email, for the first drop" }
  ]
}
{% endschema %}
