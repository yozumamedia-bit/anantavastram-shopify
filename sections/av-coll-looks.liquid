{%- comment -%}
  Looks panel (tab 02) of the meta page: the entry's `looks` list, each a `look` entry
  (number, title, images, wearer_name, wearer_occupation, wearer_city, pieces, commission_piece, commission_note).
  The grid is editorial — a wide look, an offset look, then rows of three — and collapses to one column on phones.
  Each look opens a <dialog> panel from the right listing what it is made of, with price and edition state, plus a
  "By commission" row for a piece that is not sold as a product (the gold groom set). assets/av-coll.js opens it;
  the dialog closes on its button, Escape, or a click on the dimmed page.
  Hidden at the teaser stage, when the Looks tab is locked.
{%- endcomment -%}
{%- liquid
  assign meta = nil
  if collection != blank and collection.handle != 'all'
    for m in shop.metaobjects.collection_meta.values
      if m.collection.value.id == collection.id
        assign meta = m
        break
      endif
    endfor
  endif
  assign looks = meta.looks.value
  assign stage = meta.status.value | default: 'open' | downcase | strip
  assign footnote = section.settings.footnote
  if footnote == blank and meta.weavers.value.count > 0
    assign names = ''
    for w in meta.weavers.value
      if w.name.value != blank
        if names != blank
          assign names = names | append: ', '
        endif
        assign names = names | append: w.name.value
      endif
    endfor
    if names != blank
      assign footnote = 'Woven by ' | append: names
    endif
  endif
-%}
{%- if meta != blank and looks.count > 0 and stage != 'teaser' -%}
<section class="av-coll-looks av-wrap" id="looks" data-av-panel="looks">
  <h2 class="visually-hidden">Looks</h2>
  {%- if section.settings.intro != blank -%}<p class="av-body av-body--s av-coll-looks__intro">{{ section.settings.intro | escape }}</p>{%- endif -%}
  <div class="av-coll-looks__grid">
    {%- for look in looks -%}
      {%- liquid
        assign n = look.number.value | default: forloop.index
        assign num = n | prepend: '0' | slice: -2, 2
        assign dialog_id = 'av-look-' | append: section.id | append: '-' | append: forloop.index
        assign img = nil
        for im in look.images.value limit: 1
          assign img = im
        endfor
        assign title = look.title.value | default: 'Look'
        capture wearer
          if look.wearer_name.value != blank
            echo look.wearer_name.value | escape
            if look.wearer_occupation.value != blank
              echo ' · ' | append: look.wearer_occupation.value | escape
            endif
            if look.wearer_city.value != blank
              echo ', ' | append: look.wearer_city.value | escape
            endif
          endif
        endcapture
      -%}
      <button type="button" class="av-look" data-av-look-open="{{ dialog_id }}" aria-haspopup="dialog" aria-controls="{{ dialog_id }}">
        {% render 'av-media', image: img, ratio: '4 / 5', sizes: '(min-width: 900px) 40vw, 100vw', alt: title %}
        <span class="av-look__meta"><span class="av-numeral">Look {{ num }}</span><span class="av-link" aria-hidden="true">See the look</span></span>
        <span class="av-name av-look__title">{{ title | escape }}</span>
        {%- if wearer != blank -%}<span class="av-body av-body--meta">{{ wearer }}</span>{%- endif -%}
      </button>

      <dialog class="av-look-dialog" id="{{ dialog_id }}" aria-labelledby="{{ dialog_id }}-t">
        <div class="av-look-dialog__in">
          <div class="av-look-dialog__top">
            <span class="av-numeral">Look {{ num }}</span>
            <form method="dialog"><button type="submit" class="av-look-dialog__close" aria-label="Close look">{% render 'av-icon', name: 'close' %}</button></form>
          </div>
          {%- if look.images.value.count > 0 -%}
            <div class="av-look-dialog__media">
              {%- for im in look.images.value limit: 3 -%}
                {% render 'av-media', image: im, ratio: '4 / 5', sizes: '460px', reveal: false, loading: 'lazy' %}
              {%- endfor -%}
            </div>
          {%- endif -%}
          <div class="av-stack" style="gap:6px">
            <h3 class="av-name" id="{{ dialog_id }}-t">{{ title | escape }}</h3>
            {%- if wearer != blank -%}<span class="av-body av-body--meta">Worn by {{ wearer }}</span>{%- endif -%}
          </div>
          <div class="av-look-dialog__pieces">
            <h4 class="av-label">In this look</h4>
            <ul>
              {%- for p in look.pieces.value -%}
                <li class="av-look-piece">
                  <a href="{{ p.url }}" class="av-look-piece__img" tabindex="-1" aria-hidden="true">{% render 'av-media', image: p.featured_image, ratio: '4 / 5', sizes: '72px', reveal: false %}</a>
                  <div class="av-stack" style="gap:6px">
                    <a href="{{ p.url }}" class="av-sub av-sub--s">{{ p.title | escape }}</a>
                    {%- if p.description != blank -%}<span class="av-body av-body--s">{{ p.description | strip_html | truncatewords: 18 }}</span>{%- endif -%}
                    {%- capture p_state -%}{% render 'av-edition-line', product: p, context: 'state' %}{%- endcapture -%}
                    <span class="av-price av-look-piece__price">{% if p_state contains 'enquiry' %}On enquiry · Made to order{% elsif p_state contains 'sold' %}Sold out{% else %}{% render 'av-money', price: p.price %} · {% render 'av-edition-line', product: p, context: 'tile' %}{% endif %}</span>
                    <a class="av-link" href="{{ p.url }}">See the piece</a>
                  </div>
                </li>
              {%- endfor -%}
              {%- if look.commission_piece.value != blank -%}
                <li class="av-look-piece">
                  <span class="av-look-piece__img">{% render 'av-media', image: img, ratio: '4 / 5', sizes: '72px', reveal: false, alt: '' %}</span>
                  <div class="av-stack" style="gap:6px">
                    <span class="av-sub av-sub--s">{{ look.commission_piece.value | escape }}</span>
                    {%- if look.commission_note.value != blank -%}<span class="av-body av-body--s">{{ look.commission_note.value | escape }}</span>{%- endif -%}
                    <span class="av-price av-look-piece__price">By commission</span>
                    <a class="av-link" href="{{ section.settings.commission_url | default: '/pages/commissions' }}">Enquire about a commission</a>
                  </div>
                </li>
              {%- endif -%}
            </ul>
          </div>
          {%- if footnote != blank -%}<p class="av-body av-body--meta">{{ footnote | escape }}</p>{%- endif -%}
        </div>
      </dialog>
    {%- endfor -%}
  </div>
</section>
<script src="{{ 'av-coll.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
{% schema %}
{ "name": "AV Collection looks", "settings": [
  { "type": "text", "id": "intro", "label": "Intro line", "default": "Worn by the people in them. Choose a look to see what it is made of." },
  { "type": "url", "id": "commission_url", "label": "Commissions page", "info": "Where a \"By commission\" piece links. Defaults to /pages/commissions." },
  { "type": "text", "id": "footnote", "label": "Line at the foot of each look", "info": "Leave empty to print \"Woven by\" and the collection's weavers." }
], "presets": [{ "name": "AV Collection looks" }] }
{% endschema %}
