{%- liquid
  assign mf = product.metafields.custom
  assign drop = mf.collection.value
  assign v = product.selected_or_first_available_variant | default: product.variants.first
  capture state
    render 'av-edition-line', product: product, context: 'state'
  endcapture
  assign sold_out = false
  assign soon = false
  if state contains 'soon'
    assign soon = true
  elsif state contains 'sold'
    assign sold_out = true
  endif
  assign form_id = 'product-form-' | append: section.id
  assign lead_weeks = mf.lead_time_weeks.value | default: 0
  capture label
    render 'av-piece-label', product: product, with_collection: true, numeral_prefix: 'No. '
  endcapture
  assign enquiry = false
  if state contains 'enquiry'
    assign enquiry = true
  endif
  assign commission_url = section.settings.commission_url | default: '/pages/commissions'
  assign wa_text = 'About ' | append: product.title | append: ': ' | append: shop.url | append: product.url
  comment
    What the buyer receives: every photograph shows a full outfit and only the veshti is sold, so the page says so.
    A piece whose length (custom.cloth_length) names an angavastram comes with one.
  endcomment
  assign receive = 'One veshti. The kurta in the photographs is not included.'
  if mf.cloth_length.value contains 'ngavastram'
    assign receive = 'One veshti and one angavastram. The kurta in the photographs is not included.'
  endif
  assign worn_with = mf.worn_with.value
  comment
    Availability is snippets/av-edition-line.liquid's rule; tiles, rows and the list read the same snippet.
    Everyday and Occasional pieces are in stock: sold out at inventory 0 ("continue selling" OFF), then a notify form.
    Commission pieces (custom.tier = commission) are made to order: no price, no order form, an enquiry link instead.
  endcomment
  assign renderable_media = 0
  for m in product.media
    if m.media_type == 'image' or m.media_type == 'video'
      assign renderable_media = renderable_media | plus: 1
    endif
  endfor
-%}
<script type="application/ld+json">{{ product | structured_data }}</script>
<section class="av-product">
  <div class="av-product__gallery">
  <div class="av-product__media" data-av-gallery tabindex="-1">
    {%- if renderable_media == 0 -%}
      {% render 'av-media', ratio: '4 / 5', sizes: '(min-width: 900px) 58vw, 85vw' %}
    {%- endif -%}
    {%- for media in product.media -%}
      {%- liquid
        assign loading_attr = 'lazy'
        assign vt = blank
        if forloop.first
          assign loading_attr = 'eager'
          assign vt = product.handle
        endif
      -%}
      {%- if media.media_type == 'image' -%}
        {% render 'av-media', image: media, ratio: '4 / 5', natural: true, sizes: '(min-width: 900px) 58vw, 85vw', loading: loading_attr, vt: vt, priority: forloop.first %}
      {%- elsif media.media_type == 'video' -%}
        {% render 'av-video', loop_video: media, class: 'av-product__video' %}
      {%- endif -%}
    {%- endfor -%}
  </div>
  {%- if renderable_media > 1 -%}
    <button class="av-product__nav av-product__nav--prev" type="button" data-av-prev aria-label="Previous photograph" disabled>&#8249;</button>
    <button class="av-product__nav av-product__nav--next" type="button" data-av-next aria-label="Next photograph">&#8250;</button>
    <div class="av-product__hint av-label" data-av-hint aria-hidden="true"><span class="av-product__hint-touch">Swipe for more</span><span class="av-product__hint-mouse">More photographs</span> <span class="av-product__hint-arrow">&#8594;</span></div>
    <div class="av-product__count av-label" aria-hidden="true"><span data-av-count>1</span> / {{ renderable_media }}</div>
  {%- endif -%}
  {%- if renderable_media > 0 -%}<button class="av-product__more" type="button" data-av-more aria-label="See every photograph, large">+</button>{%- endif -%}
  </div>

  <div class="av-product__panel">
    <div class="av-product__title">
      {%- if label != blank -%}<div class="av-label">{{ label }}</div>{%- endif -%}
      <h1 class="av-name">{{ product.title | escape }}</h1>
      {%- if enquiry -%}
      <div class="av-price">On enquiry</div>
      {%- elsif soon -%}
      <div class="av-price">{% render 'av-edition-line', product: product, context: 'tile' %}</div>
      {%- else -%}
      <div class="av-price">{% render 'av-money', price: v.price %}</div>
      {%- endif -%}
      {%- if settings.av_tax_line != blank and enquiry == false and soon == false -%}<div class="av-label av-price__note">{{ settings.av_tax_line | escape }}</div>{%- endif -%}
    </div>
    <div class="av-product__notes">
      {%- if enquiry -%}
      <div class="av-row__note"><div class="av-label">Availability</div><div class="av-body av-body--s">Made to order, after a conversation.{% if lead_weeks > 0 %} About {{ lead_weeks }} {% if lead_weeks == 1 %}week{% else %}weeks{% endif %} from confirmation.{% endif %}</div></div>
      {%- elsif soon -%}
      {%- assign soon_left = 0 -%}{%- capture soon_left -%}{% render 'av-edition-line', product: product, context: 'remaining' %}{%- endcapture -%}{%- assign soon_left = soon_left | strip | plus: 0 -%}
      <div class="av-row__note"><div class="av-label">Availability</div><div class="av-body av-body--s">{% if soon_left > 0 %}{{ soon_left }} {% if soon_left == 1 %}piece{% else %}pieces{% endif %}, kept ready for the opening.{% else %}Held for the opening.{% endif %}</div></div>
      {%- else -%}
      <div class="av-row__note"><div class="av-label">Availability</div><div class="av-body av-body--s">{% if sold_out %}Sold out. We make it again if there is demand.{% else %}Ready in our studio. Sent from Chennai in six to eight days.{% endif %}</div></div>
      {%- endif -%}
      {%- unless enquiry -%}<div class="av-row__note"><div class="av-label">You receive</div><div class="av-body av-body--s">{{ receive }}</div></div>{%- endunless -%}
    </div>

    <div class="av-product__actions">
      {%- if enquiry -%}
        <a class="av-button" href="{{ commission_url }}">Enquire about this piece</a>
      {%- elsif sold_out or soon -%}
        {%- comment -%}
          A customer record, not a contact-form email: Customers → filter by tag "notify-<handle>" (or "opening") to write
          to everyone who asked. Customer forms subscribe the address to email marketing, so consent is recorded.
        {%- endcomment -%}
        {%- form 'customer', id: 'av-notify', class: 'av-notify' -%}
          <input type="hidden" name="contact[tags]" value="{% if soon %}opening, {% endif %}notify, notify-{{ product.handle }}">
          {%- if form.posted_successfully? -%}
            <div class="av-body av-body--s" role="status">{% if soon %}Noted. You will hear from us when it opens.{% else %}Noted. You will hear from us when we have made this piece again.{% endif %}</div>
          {%- else -%}
            <label class="av-label" for="av-notify-email">{% if soon %}Tell me when it opens{% else %}Tell me when it is back{% endif %}</label>
            <input id="av-notify-email" type="email" name="contact[email]" value="{{ form.email | escape }}" placeholder="Your email" autocomplete="email" required{% if form.errors %} aria-invalid="true" aria-describedby="av-notify-err"{% endif %}>
            {%- if form.errors -%}<div id="av-notify-err" class="av-body av-body--s" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
            <button class="av-button" type="submit">Tell me</button>
          {%- endif -%}
        {%- endform -%}
      {%- else -%}
        <product-form class="product-form">
          <div class="product-form__error-message-wrapper" role="alert" hidden><span class="product-form__error-message"></span></div>
          {%- form 'product', product, id: form_id, class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
            <input type="hidden" name="id" value="{{ v.id }}" disabled class="product-variant-id">
            <input type="hidden" name="quantity" value="1">
            <button id="ProductSubmitButton-{{ section.id }}" type="submit" name="add" class="av-button product-form__submit"><span>Order this piece</span><span class="loading-overlay__spinner hidden"></span></button>
          {%- endform -%}
        </product-form>
      {%- endif -%}
      {%- unless enquiry -%}
      {%- comment -%} Seeing the piece before paying: the reassurance beside the button, since a piece is returned only if it arrives damaged (16 Nov 2026). {%- endcomment -%}
      
      <p class="av-body av-body--s av-product__see">See it before you pay, on a video call or at our Chennai studio.</p>
      {%- endunless -%}
      {% render 'av-whatsapp-link', label: 'Ask on WhatsApp', text: wa_text %}
    </div>

    {%- comment -%} Price, availability and the button come first; the story of the piece follows (site review, 4 Nov 2026). {%- endcomment -%}
    {%- comment -%} The description is the story of the piece, then a "Details" list. The story is printed here; the list becomes the first panel below (16 Nov 2026: fewer rows, more air). {%- endcomment -%}
    {%- assign desc_parts = product.description | split: '<h3>Details</h3>' -%}
    {%- if desc_parts.first != blank -%}<div class="av-body av-product__desc">{{ desc_parts.first }}</div>{%- endif -%}

    {%- comment -%} Six panels at most (16 Nov 2026): Details (open), How it is made, Size guide, Shipping and returns, Cloth and care, Before you order. {%- endcomment -%}
    <div class="av-product__accordions">
      {%- if desc_parts.size > 1 -%}
      <details class="av-acc" open><summary><h2 class="av-acc__title">Details</h2><span class="av-acc__mark" aria-hidden="true"></span></summary><div class="av-acc__body av-body av-body--s av-product__desc av-product__details">{{ desc_parts.last }}</div></details>
      {%- endif -%}
      {%- if mf.how_made.value != blank -%}
      <details class="av-acc"><summary><h2 class="av-acc__title">How it is made</h2><span class="av-acc__mark" aria-hidden="true"></span></summary><div class="av-acc__body av-body av-body--s">{{ mf.how_made.value | escape | newline_to_br }}</div></details>
      {%- endif -%}
      <details class="av-acc"><summary><h2 class="av-acc__title">Size guide</h2><span class="av-acc__mark" aria-hidden="true"></span></summary><div class="av-acc__body av-body av-body--s">
        <p>The veshti is one length of cloth{% if mf.cloth_length.value != blank %} ({{ mf.cloth_length.value | escape }}){% endif %}. It is tied at the waist, so it is not sized. If you would like help tying it, message us on WhatsApp.</p>
        <p>Kurtas and shirts are made to these standard measurements, or to your own as a <a href="{{ commission_url }}">commission</a>. All measurements are in inches.</p>
        <div class="av-size"><table class="av-size__table"><thead><tr><th scope="col">Measurement</th><th scope="col">S</th><th scope="col">M</th><th scope="col">L</th><th scope="col">XL</th></tr></thead><tbody><tr><th scope="row">Full length</th><td>41</td><td>42</td><td>43</td><td>44</td></tr><tr><th scope="row">Short length</th><td>34</td><td>35</td><td>36</td><td>37</td></tr><tr><th scope="row">Shoulder</th><td>18</td><td>18½</td><td>19</td><td>19½</td></tr><tr><th scope="row">Chest</th><td>42</td><td>44</td><td>46</td><td>48</td></tr><tr><th scope="row">Waist</th><td>42</td><td>44</td><td>46</td><td>48</td></tr><tr><th scope="row">Hip circumference</th><td>44</td><td>46</td><td>48</td><td>50</td></tr><tr><th scope="row">Armhole</th><td>18½</td><td>19½</td><td>20½</td><td>21½</td></tr><tr><th scope="row">Sleeve length</th><td>24½</td><td>25½</td><td>26½</td><td>27½</td></tr><tr><th scope="row">Sleeve loose</th><td>9</td><td>9½</td><td>10</td><td>11</td></tr><tr><th scope="row">Bicep</th><td>13</td><td>14</td><td>15</td><td>15½</td></tr><tr><th scope="row">Collar</th><td>16</td><td>16½</td><td>17</td><td>18</td></tr></tbody></table></div>
      </div></details>
      {%- unless enquiry -%}
      <details class="av-acc"><summary><h2 class="av-acc__title">Shipping and returns</h2><span class="av-acc__mark" aria-hidden="true"></span></summary><div class="av-acc__body av-body av-body--s">{%- if section.settings.shipping != blank -%}{{ section.settings.shipping }}{%- else -%}<p>Orders are sent from Chennai in six to eight days. Shipping in India is free and insured, and usually takes 2 to 5 working days after dispatch. Expedited shipping is ₹500.</p><p>We ship worldwide from Chennai, by insured courier. The checkout here is for delivery in India. For an order to any other country, message us on WhatsApp with your address, and we will confirm the shipping cost, the delivery time and any import duty before you pay.</p>{%- endif -%}{%- if shop.shipping_policy.body != blank -%}<p><a href="{{ shop.shipping_policy.url }}">The shipping policy</a></p>{%- endif -%}{%- if settings.av_returns_line != blank -%}<p class="av-faq__q">Returns</p><p>{{ settings.av_returns_line | escape }}</p>{%- if shop.refund_policy.body != blank -%}<p><a href="{{ shop.refund_policy.url }}">The full returns policy</a></p>{%- endif -%}{%- endif -%}</div></details>
      {%- endunless -%}
      <details class="av-acc"><summary><h2 class="av-acc__title">Cloth and care</h2><span class="av-acc__mark" aria-hidden="true"></span></summary><div class="av-acc__body av-body av-body--s">{%- unless enquiry -%}<p>Colours on screen can differ slightly from the cloth. Handloom cloth carries slubs, joined threads and small changes in the weave from one length to the next. They do not affect how the piece wears, and no two pieces are exactly alike.</p>{%- endunless -%}<p class="av-faq__q">Care</p>{%- if mf.care.value != blank -%}<p>{{ mf.care.value | escape | newline_to_br }}</p>{%- else -%}{{ section.settings.care }}{%- endif -%}</div></details>
      {%- unless enquiry -%}
      <details class="av-acc"><summary><h2 class="av-acc__title">Before you order</h2><span class="av-acc__mark" aria-hidden="true"></span></summary><div class="av-acc__body av-body av-body--s av-faq"><p class="av-faq__q">Does it come with the kurta?</p><p>No. You receive the veshti, and the angavastram where the page says so. The kurta in the photographs is not included. A kurta can be made to your measure as a <a href="{{ commission_url }}">commission</a>.</p><p class="av-faq__q">How do I wear it?</p><p>If you would like help tying the veshti, message us on WhatsApp.</p><p class="av-faq__q">Will it reach me before my date?</p><p>Orders are sent from Chennai in six to eight days. Delivery in India usually takes 2 to 5 working days after that, and we ship worldwide. For a close date, choose expedited shipping or message us first.</p><p class="av-faq__q">Can I see it before I buy?</p><p>Message us on WhatsApp and we will send more photographs or a short video of the piece. You can also see it at our Chennai studio, by appointment.</p><p class="av-faq__q">Can I return it?</p><p>Only if it arrives damaged. We confirm every order with you by chat or email before it is dispatched. If the piece arrives damaged, write to us within 48 hours of delivery, with photographs.{% if shop.refund_policy.body != blank %} The full policy is under <a href="{{ shop.refund_policy.url }}">Returns</a>.{% endif %}</p></div></details>
      {%- endunless -%}
    </div>

    {%- if worn_with.size > 0 -%}
    {%- comment -%} The other pieces of the set (product metafield custom.worn_with). Three at most; a swipe rail on phones. {%- endcomment -%}
    <div class="av-worn">
      <h2 class="av-label">Worn with</h2>
      <div class="av-worn__tiles">
        {%- for p in worn_with limit: 3 -%}{%- unless p.handle == product.handle -%}{% render 'av-drop-tile', product: p %}{%- endunless -%}{%- endfor -%}
      </div>
    </div>
    {%- endif -%}
  </div>
</section>
{%- unless sold_out or enquiry or soon -%}
{%- comment -%} Phones only: a slim order bar once the main button has scrolled out of view. The button submits the product form above via its form attribute. {%- endcomment -%}
<div class="av-orderbar" id="av-orderbar" aria-hidden="true">
  <div class="av-orderbar__info"><span class="av-orderbar__name">{{ product.title | escape }}</span><span class="av-orderbar__price">{% render 'av-money', price: v.price %}</span></div>
  <button class="av-button av-orderbar__button" type="submit" form="{{ form_id }}" tabindex="-1">Order</button>
</div>
{%- endunless -%}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<dialog class="av-zoom" id="av-zoom" aria-label="{{ product.title | escape }}, photographs">
  <button class="av-zoom__close" type="button" data-av-zoom-close>Close</button>
  <button class="av-zoom__nav av-zoom__nav--prev" type="button" data-av-zoom-prev aria-label="Previous photograph">&#8249;</button>
  <button class="av-zoom__nav av-zoom__nav--next" type="button" data-av-zoom-next aria-label="Next photograph">&#8250;</button>
  <div class="av-zoom__count av-label" aria-hidden="true"><span data-av-zoom-count>1</span> / {{ renderable_media }}</div>
  <div class="av-zoom__strip" data-av-zoom-strip></div>
</dialog>
<script src="{{ 'av-product.js' | asset_url }}" defer="defer"></script>
{% schema %}
{ "name": "AV Product", "settings": [
  { "type": "richtext", "id": "shipping", "label": "Shipping text (overrides theme setting)" },
  { "type": "url", "id": "commission_url", "label": "Commissions page (enquiry link on commission pieces)" },
  { "type": "richtext", "id": "care", "label": "Default care text" }
] }
{% endschema %}
