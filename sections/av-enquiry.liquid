{%- comment -%}
  Enquiry form for Kamalam: used on the Commissions page and the Contact page. Three ways in — the form, a booking link (Google Calendar or similar), WhatsApp.
  States: default, focus, invalid, sending, sent, failed. av-enquiry.js validates on leaving a field and on Send, posts with fetch and shows the sent
  state in place. Without JS the native post and Shopify's redirect to ?contact_posted=true render the same sent state here.
  `form` only exists inside {% form %}, so the form is captured first; the flag it sets decides what is shown around it.
{%- endcomment -%}
{%- liquid
  assign today = 'now' | date: '%Y-%m-%d'
  assign lead_weeks = section.settings.lead_weeks | default: 8
  assign reply_line = section.settings.reply_line | strip
  assign wa_label = 'WhatsApp · ' | append: settings.av_whatsapp_number
  assign wa_text = 'A commission enquiry'
  assign sent = false
  assign email_invalid = false
  assign other_error = false
-%}
<section class="av-enquiry" id="av-enquiry">
  <div class="av-stack">
    {%- if section.settings.label != blank -%}<div class="av-label">{{ section.settings.label | escape }}</div>{%- endif -%}
    <h2 class="av-sub av-sub--m">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.text != blank -%}<div class="av-body">{{ section.settings.text | escape | newline_to_br }}</div>{%- endif -%}
    {%- if section.settings.calendar_url != blank -%}
      <div class="av-stack" style="gap:8px">
        <a class="av-link" href="{{ section.settings.calendar_url }}" target="_blank" rel="noopener" aria-describedby="a11y-new-window-message">{{ section.settings.calendar_label | default: 'Book a call' | escape }}</a>
        {%- if section.settings.calendar_note != blank -%}<span class="av-body av-body--meta">{{ section.settings.calendar_note | escape }}</span>{%- endif -%}
      </div>
    {%- endif -%}
    {% render 'av-whatsapp-link', label: wa_label, text: wa_text, class: 'av-link av-enquiry__wa' %}
  </div>
  {%- capture enquiry_form -%}
    {%- form 'contact', id: 'av-enquiry-form', class: 'av-form', data-lead-weeks: lead_weeks -%}
      {%- if form.posted_successfully? -%}
        {%- assign sent = true -%}
      {%- else -%}
        {%- if form.errors -%}
          {%- for field in form.errors -%}
            {%- if field == 'email' -%}{%- assign email_invalid = true -%}{%- else -%}{%- assign other_error = true -%}{%- endif -%}
          {%- endfor -%}
        {%- endif -%}
        <input type="hidden" name="contact[subject]" value="{{ section.settings.subject | default: 'Enquiry' | escape }}">
        {%- if section.settings.tag != blank -%}<input type="hidden" name="contact[tags]" value="{{ section.settings.tag | escape }}">{%- endif -%}

        <div class="av-field">
          <label class="av-field__label" for="enq-name">Name <abbr title="required">*</abbr></label>
          <input id="enq-name" type="text" name="contact[name]" value="{{ form.name | escape }}" autocomplete="name" required>
          <p class="av-field__error" id="enq-name-error">Your name, so Kamalam can reply.</p>
        </div>

        <div class="av-field{% if email_invalid %} is-invalid{% endif %}">
          <label class="av-field__label" for="enq-email">Email <abbr title="required">*</abbr></label>
          <input id="enq-email" type="email" name="contact[email]" value="{{ form.email | escape }}" autocomplete="email" required{% if email_invalid %} aria-invalid="true" aria-describedby="enq-email-error"{% endif %}>
          <p class="av-field__error" id="enq-email-error">An email we can reply to.</p>
        </div>

        <div class="av-field">
          <label class="av-field__label" for="enq-phone">Phone (optional)</label>
          <input id="enq-phone" type="tel" name="contact[phone]" value="{{ form.phone | escape }}" placeholder="With country code" autocomplete="tel">
        </div>

        <fieldset class="av-field av-chips" id="enq-occasion">
          <legend class="av-field__label">The occasion <abbr title="required">*</abbr></legend>
          <div class="av-chips__row">
            <input type="radio" id="enq-occasion-wedding" name="contact[occasion]" value="Wedding" required><label for="enq-occasion-wedding">Wedding</label>
            <input type="radio" id="enq-occasion-reception" name="contact[occasion]" value="Reception"><label for="enq-occasion-reception">Reception</label>
            <input type="radio" id="enq-occasion-other" name="contact[occasion]" value="Other"><label for="enq-occasion-other">Other</label>
          </div>
          <p class="av-field__error" id="enq-occasion-error">Choose the occasion.</p>
        </fieldset>

        <div class="av-field">
          <label class="av-field__label" for="enq-date">The date <abbr title="required">*</abbr></label>
          <input id="enq-date" type="date" name="contact[date]" min="{{ today }}" required>
          <p class="av-field__error" id="enq-date-error" data-missing="Choose a date." data-past="Choose a date from today on.">Choose a date.</p>
          <p class="av-field__hint" id="enq-date-hint" role="status" data-text="That date is inside the {{ lead_weeks }}-week lead time. Kamalam can still reply — say so in your note, or choose a later date."></p>
        </div>

        <div class="av-field">
          <label class="av-field__label" for="enq-city">City</label>
          <input id="enq-city" type="text" name="contact[city]" placeholder="Where the fitting would be" autocomplete="address-level2">
        </div>

        <fieldset class="av-field av-chips" id="enq-language">
          <legend class="av-field__label">Language</legend>
          <div class="av-chips__row">
            <input type="radio" id="enq-language-tamil" name="contact[language]" value="Tamil"><label for="enq-language-tamil">Tamil</label>
            <input type="radio" id="enq-language-english" name="contact[language]" value="English"><label for="enq-language-english">English</label>
          </div>
        </fieldset>

        <div class="av-field av-field--wide">
          <label class="av-field__label" for="enq-notes">A few lines</label>
          <textarea id="enq-notes" name="contact[body]" rows="4" placeholder="What you have in mind — a border you remember, a colour, a family motif, the pieces in the set">{{ form.body | escape }}</textarea>
        </div>

        <p class="av-form__error" role="alert" aria-live="polite" data-text="That did not send. Nothing was lost — try again, or write on WhatsApp.">{% if other_error %}{{ form.errors | default_errors }}{% endif %}</p>
        <div class="av-form__foot">
          <span class="av-body av-body--meta">{% if reply_line != blank %}{{ reply_line | escape }} · nothing is shared{% else %}Nothing is shared{% endif %}</span>
          <button class="av-button" type="submit"><span class="av-button__spinner" aria-hidden="true"></span>Send</button>
        </div>
      {%- endif -%}
    {%- endform -%}
  {%- endcapture -%}
  {%- if sent -%}{%- assign enquiry_form = enquiry_form | replace_first: 'class="av-form"', 'class="av-form is-sent"' -%}{%- endif -%}
  <av-enquiry-form class="av-enquiry__panel">
    {{ enquiry_form }}
    <div class="av-sent" id="av-enquiry-sent"{% unless sent %} hidden{% endunless %}>
      <h2 class="av-sub av-sub--m" tabindex="-1">Kamalam has your note.</h2>
      {%- if reply_line != blank -%}<p class="av-body">{{ reply_line | escape }}{% unless reply_line contains '.' %}.{% endunless %}</p>{%- endif -%}
      <div class="av-sent__routes">
        {% render 'av-whatsapp-link', label: wa_label, text: wa_text, class: 'av-link av-enquiry__wa' %}
        <a class="av-link" href="{{ routes.collections_url }}">Back to the pieces</a>
      </div>
    </div>
  </av-enquiry-form>
</section>
<script src="{{ 'av-enquiry.js' | asset_url }}" defer="defer"></script>
{% schema %}
{ "name": "AV Enquiry form", "limit": 1, "settings": [
  { "type": "text", "id": "label", "label": "Label", "default": "Begin" },
  { "type": "text", "id": "heading", "label": "Heading", "default": "Write to Kamalam" },
  { "type": "textarea", "id": "text", "label": "Text", "default": "Three lines are enough: the occasion, the date, and where you are. Or send the same on WhatsApp." },
  { "type": "text", "id": "subject", "label": "Email subject line", "info": "Subject of the email the store receives.", "default": "Commissions enquiry" },
  { "type": "text", "id": "tag", "label": "Customer tag", "info": "Added to the sender's customer record, so enquiries can be filtered in Customers.", "default": "commissions" },
  { "type": "text", "id": "reply_line", "label": "Reply-time line", "info": "Shown under the form and after sending, e.g. Kamalam replies within 3 days", "default": "Kamalam replies within [n] days" },
  { "type": "number", "id": "lead_weeks", "label": "Lead time (weeks)", "info": "A date inside this window gets a note under the date field. It is not blocked.", "default": 8 },
  { "type": "header", "content": "Book a call" },
  { "type": "url", "id": "calendar_url", "label": "Booking link", "info": "A Google Calendar appointment schedule link (calendar.app.google/…) or similar. Hidden until set." },
  { "type": "text", "id": "calendar_label", "label": "Booking link label", "default": "Book a call with Kamalam" },
  { "type": "text", "id": "calendar_note", "label": "Booking note", "info": "e.g. 20 minutes · Tamil or English · video or phone" }
], "presets": [{ "name": "AV Enquiry form" }] }
{% endschema %}
