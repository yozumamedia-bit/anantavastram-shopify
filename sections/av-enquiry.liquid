{%- comment -%} Enquiry form for Kamalam: used on the Exclusive page and the Contact page. Three ways in — the form, a booking link (Google Calendar or similar), WhatsApp. {%- endcomment -%}
<section class="av-enquiry av-reveal" id="av-enquiry">
  <div class="av-stack">
    {%- if section.settings.label != blank -%}<div class="av-label">{{ section.settings.label | escape }}</div>{%- endif -%}
    <h2 class="av-sub av-sub--m">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.text != blank -%}<div class="av-body">{{ section.settings.text | escape | newline_to_br }}</div>{%- endif -%}
    {%- if section.settings.calendar_url != blank -%}
      <div class="av-stack" style="gap:8px">
        <a class="av-link" href="{{ section.settings.calendar_url }}" target="_blank" rel="noopener" aria-describedby="a11y-new-window-message">{{ section.settings.calendar_label | default: 'Book a call' | escape }}</a>
        {%- if section.settings.calendar_note != blank -%}<span class="av-label" style="color:var(--av-grey-1)">{{ section.settings.calendar_note | escape }}</span>{%- endif -%}
      </div>
    {%- endif -%}
    {%- assign wa_label = 'WhatsApp · ' | append: settings.av_whatsapp_number -%}
    {% render 'av-whatsapp-link', label: wa_label, text: 'An enquiry for a piece made to order' %}
  </div>
  {%- form 'contact', id: 'av-enquiry-form', class: 'av-form' -%}
    <input type="hidden" name="contact[subject]" value="{{ section.settings.subject | default: 'Enquiry' | escape }}">
    {%- if form.posted_successfully? -%}
      <div class="av-form__msg av-body" role="status" tabindex="-1" autofocus>Received.{% if section.settings.reply_line != blank %} {{ section.settings.reply_line | escape }}{% unless section.settings.reply_line contains '.' %}.{% endunless %}{% endif %}</div>
    {%- else -%}
      {%- if form.errors -%}<div id="enq-errors" class="av-form__msg av-body av-body--s" role="alert" tabindex="-1" autofocus>{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="av-field"><label class="av-label" for="enq-name">Name</label><input id="enq-name" type="text" name="contact[name]" value="{{ form.name | escape }}" placeholder="Your name" autocomplete="name" required></div>
      <div class="av-field"><label class="av-label" for="enq-email">Email</label><input id="enq-email" type="email" name="contact[email]" value="{{ form.email | escape }}" placeholder="So we can reply" autocomplete="email" required{% if form.errors contains 'email' %} aria-invalid="true" aria-describedby="enq-errors"{% endif %}></div>
      <div class="av-field"><label class="av-label" for="enq-phone">Phone (optional)</label><input id="enq-phone" type="tel" name="contact[phone]" value="{{ form.phone | escape }}" placeholder="With country code" autocomplete="tel"></div>
      <div class="av-field"><label class="av-label" for="enq-city">City</label><input id="enq-city" type="text" name="contact[city]" placeholder="Where the fitting would be" autocomplete="address-level2"></div>
      <div class="av-field"><label class="av-label" for="enq-occasion">The occasion</label><input id="enq-occasion" type="text" name="contact[occasion]" placeholder="Wedding · reception · other"></div>
      <div class="av-field"><label class="av-label" for="enq-date">The date</label><input id="enq-date" type="text" name="contact[date]" placeholder="When it is needed by"></div>
      <div class="av-field"><label class="av-label" for="enq-wearer">Who will wear it</label><input id="enq-wearer" type="text" name="contact[wearer]" placeholder="Yourself · the groom · a name"></div>
      <div class="av-field"><label class="av-label" for="enq-lang">Language</label><select id="enq-lang" name="contact[language]"><option value="">No preference</option><option>Tamil</option><option>English</option></select></div>
      <div class="av-field av-field--wide"><label class="av-label" for="enq-notes">A few lines</label><textarea id="enq-notes" name="contact[body]" placeholder="What you have in mind — a border you remember, a colour, a family motif, the pieces in the set">{{ form.body | escape }}</textarea></div>
      <div class="av-form__foot">{%- if section.settings.reply_line != blank -%}<span class="av-label">{{ section.settings.reply_line | escape }}</span>{%- endif -%}<button class="av-button" type="submit">Send</button></div>
    {%- endif -%}
  {%- endform -%}
</section>
{% schema %}
{ "name": "AV Enquiry form", "limit": 1, "settings": [
  { "type": "text", "id": "label", "label": "Label", "default": "Begin" },
  { "type": "text", "id": "heading", "label": "Heading", "default": "Write to Kamalam" },
  { "type": "textarea", "id": "text", "label": "Text", "default": "Three lines are enough: the occasion, the date, and where you are. Or send the same on WhatsApp." },
  { "type": "text", "id": "subject", "label": "Email subject line", "info": "Subject of the email the store receives.", "default": "Exclusive enquiry" },
  { "type": "text", "id": "reply_line", "label": "Reply-time line", "info": "Shown under the form and after sending, e.g. Kamalam replies within 3 days", "default": "Kamalam replies within [n] days" },
  { "type": "header", "content": "Book a call" },
  { "type": "url", "id": "calendar_url", "label": "Booking link", "info": "A Google Calendar appointment schedule link (calendar.app.google/…) or similar. Hidden until set." },
  { "type": "text", "id": "calendar_label", "label": "Booking link label", "default": "Book a call with Kamalam" },
  { "type": "text", "id": "calendar_note", "label": "Booking note", "info": "e.g. 20 minutes · Tamil or English · video or phone" }
], "presets": [{ "name": "AV Enquiry form" }] }
{% endschema %}
