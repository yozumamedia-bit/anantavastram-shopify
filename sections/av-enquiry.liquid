<section class="av-enquiry av-reveal" id="av-enquiry">
  <div class="av-stack">
    {%- if section.settings.label != blank -%}<div class="av-label">{{ section.settings.label | escape }}</div>{%- endif -%}
    <h2 class="av-sub av-sub--m">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.text != blank -%}<div class="av-body">{{ section.settings.text | escape | newline_to_br }}</div>{%- endif -%}
    {%- liquid
      assign wa_label = 'WhatsApp'
      if settings.av_whatsapp_number != blank
        assign wa_label = 'WhatsApp · ' | append: settings.av_whatsapp_number
      endif
    -%}
    {% render 'av-whatsapp-link', label: wa_label, text: 'An enquiry for a piece made to order' %}
  </div>
  {%- form 'contact', id: 'av-enquiry-form', class: 'av-form' -%}
    <input type="hidden" name="contact[subject]" value="Exclusive enquiry">
    {%- if form.posted_successfully? -%}
      <div class="av-form__msg av-body" role="status">Received. {{ section.settings.reply_line | escape }}.</div>
    {%- else -%}
      {%- if form.errors -%}<div id="enq-errors" class="av-form__msg av-body av-body--s" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="av-field"><label class="av-label" for="enq-name">Name</label><input id="enq-name" type="text" name="contact[name]" value="{{ form.name | escape }}" placeholder="Your name" autocomplete="name" required></div>
      <div class="av-field"><label class="av-label" for="enq-email">Email</label><input id="enq-email" type="email" name="contact[email]" value="{{ form.email | escape }}" placeholder="So we can reply" autocomplete="email" required{% if form.errors contains 'email' %} aria-invalid="true" aria-describedby="enq-errors"{% endif %}></div>
      <div class="av-field"><label class="av-label" for="enq-phone">Phone (optional)</label><input id="enq-phone" type="tel" name="contact[phone]" placeholder="With country code" autocomplete="tel"></div>
      <div class="av-field"><label class="av-label" for="enq-occasion">The occasion</label><input id="enq-occasion" type="text" name="contact[occasion]" placeholder="Wedding · other"></div>
      <div class="av-field"><label class="av-label" for="enq-date">The date</label><input id="enq-date" type="text" name="contact[date]" placeholder="When it is needed by"></div>
      <div class="av-field"><label class="av-label" for="enq-city">City</label><input id="enq-city" type="text" name="contact[city]" placeholder="Where the fitting would be" autocomplete="address-level2"></div>
      <div class="av-field av-field--wide"><label class="av-label" for="enq-lang">Language</label><select id="enq-lang" name="contact[language]"><option>Tamil</option><option>English</option></select></div>
      <div class="av-field av-field--wide"><label class="av-label" for="enq-notes">A few lines</label><textarea id="enq-notes" name="contact[body]" placeholder="What you have in mind — a border you remember, a colour, a family motif">{{ form.body | escape }}</textarea></div>
      <div class="av-form__foot">{%- if section.settings.reply_line != blank -%}<span class="av-label">{{ section.settings.reply_line | escape }}</span>{%- endif -%}<button class="av-button" type="submit">Send</button></div>
    {%- endif -%}
  {%- endform -%}
</section>
{% schema %}
{ "name": "AV Enquiry form", "limit": 1, "settings": [
  { "type": "text", "id": "label", "label": "Label", "default": "Begin" },
  { "type": "text", "id": "heading", "label": "Heading", "default": "Write to Kamalam" },
  { "type": "textarea", "id": "text", "label": "Text", "default": "Three lines are enough: the occasion, the date, and where you are. Or send the same on WhatsApp." },
  { "type": "text", "id": "reply_line", "label": "Reply-time line", "info": "Shown under the form and after sending, e.g. Kamalam replies within 3 days", "default": "Kamalam replies within [n] days" }
], "presets": [{ "name": "AV Enquiry form" }] }
{% endschema %}
