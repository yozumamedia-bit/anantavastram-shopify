{%- comment -%}
  Search in the house's layout and voice: the av-intro heading, one field, then pieces as the Products page's compact
  list (snippets/av-product-list-item.liquid — the edition rule, no sale badges) and stories and pages as plain rows.
  No filters or sorting: the catalogue is a handful of named pieces.
{%- endcomment -%}
{%- paginate search.results by 24 -%}
<section class="av-intro av-intro--open">
  <div class="av-stack" style="gap:28px">
    <div class="av-label">Search</div>
    <h1 class="av-statement av-statement--xl">{% if search.performed %}{{ search.terms | escape }}{% else %}Search the house.{% endif %}</h1>
  </div>
  <div class="av-stack">
    <form action="{{ routes.search_url }}" method="get" role="search" class="av-notify">
      <label class="av-label" for="av-search-q">A piece, a motif, a weaver, a story</label>
      <input id="av-search-q" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search" autocomplete="off">
      <input type="hidden" name="options[prefix]" value="last">
      <button class="av-button" type="submit">Search</button>
    </form>
    {%- if search.performed -%}
      <p class="av-body av-body--meta" role="status">
        {%- if search.results_count == 0 -%}
          Nothing found for “{{ search.terms | escape }}”. Try a single word: a motif, a colour, a collection’s name.
        {%- elsif search.results_count == 1 -%}
          One result.
        {%- else -%}
          {{ search.results_count }} results.
        {%- endif -%}
      </p>
    {%- endif -%}
  </div>
</section>

{%- if search.performed and search.results_count > 0 -%}
<section class="av-list">
  <h2 class="visually-hidden">Results</h2>
  <ul class="av-list__items">
    {%- for item in search.results -%}
      {%- case item.object_type -%}
        {%- when 'product' -%}
          {% render 'av-product-list-item', product: item %}
        {%- when 'article' -%}
          <li class="av-list__row"><a class="av-stack" style="gap:8px;padding:24px 0" href="{{ item.url }}"><span class="av-label">Story</span><span class="av-sub av-sub--s">{{ item.title | escape }}</span></a></li>
        {%- when 'page' -%}
          <li class="av-list__row"><a class="av-stack" style="gap:8px;padding:24px 0" href="{{ item.url }}"><span class="av-label">Page</span><span class="av-sub av-sub--s">{{ item.title | escape }}</span></a></li>
      {%- endcase -%}
    {%- endfor -%}
  </ul>
  {%- if paginate.pages > 1 -%}<nav class="av-list__pages" aria-label="Pagination">{{ paginate | default_pagination }}</nav>{%- endif -%}
</section>
{%- endif -%}
{%- endpaginate -%}

{% schema %}
{ "name": "AV Search", "settings": [] }
{% endschema %}
