{%- liquid
  assign drop = section.settings.drop
  if drop == blank
    assign want = section.settings.auto_index
    assign seen = 0
    for i in (1..50) reversed
      assign h = i | prepend: '00' | slice: -3, 3 | prepend: 'drop-'
      assign d = shop.metaobjects.drop[h]
      if d == blank or d.status.value == 'closed' or d.collection.value == blank or d.collection.value.products_count == 0
        continue
      endif
      assign seen = seen | plus: 1
      if seen == want
        assign drop = d
        break
      endif
    endfor
  endif
-%}
{%- if drop != blank and drop.collection.value != blank and drop.collection.value.products_count > 0 -%}
  {%- liquid
    assign col = drop.collection.value
    assign count = col.products_count
    assign padded = drop.number.value | prepend: '00' | slice: -3, 3
    assign label = 'Drop ' | append: padded
    assign title = drop.theme_name.value | default: label
    if count == 1
      assign meta = '1 piece'
    else
      assign meta = count | append: ' pieces'
    endif
    if drop.season.value != blank
      assign meta = meta | append: ' · ' | append: drop.season.value
    endif
  -%}
  <section class="av-drop-rows">
    {% render 'av-drop-banner', label: label, title: title, meta: meta %}
    <div class="av-rows">
      {%- for product in col.products limit: 12 -%}{% render 'av-product-row', product: product %}{%- endfor -%}
    </div>
  </section>
{%- endif -%}
{% schema %}
{ "name": "AV Drop rows", "settings": [
  { "type": "metaobject", "metaobject_type": "drop", "id": "drop", "label": "Drop (leave empty to pick automatically)", "info": "Set both drop rows the same way — both automatic or both chosen — so they never show the same drop." },
  { "type": "range", "id": "auto_index", "min": 1, "max": 3, "step": 1, "default": 1, "label": "Automatic pick: Nth newest open drop", "info": "Closed drops and drops whose collection is empty are skipped." }
], "presets": [{ "name": "AV Drop rows" }] }
{% endschema %}
