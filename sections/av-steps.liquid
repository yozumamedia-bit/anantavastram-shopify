{%- if section.blocks.size > 0 -%}
<section class="av-steps">
  <div class="av-people__head">
    <div class="av-stack" style="gap:12px">
      {%- if section.settings.label != blank -%}<div class="av-label">{{ section.settings.label | escape }}</div>{%- endif -%}
      <h2 class="av-sub av-sub--m">{{ section.settings.heading | escape }}</h2>
    </div>
    {%- if section.settings.text != blank -%}<div class="av-body" style="max-width:560px">{{ section.settings.text | escape | newline_to_br }}</div>{%- endif -%}
  </div>
  <div class="av-steps__grid">
    {%- for block in section.blocks -%}
      <div class="av-step" {{ block.shopify_attributes }}>
        <div class="av-step__num" aria-hidden="true">{{ block.settings.numeral | escape }}</div>
        <h3 class="av-sub av-sub--xs av-step__title">{{ block.settings.title | escape }}</h3>
        <div class="av-body av-body--s">{{ block.settings.text | escape | newline_to_br }}</div>
      </div>
    {%- endfor -%}
  </div>
</section>
{%- endif -%}
{% schema %}
{ "name": "AV Steps", "max_blocks": 4, "settings": [
  { "type": "text", "id": "label", "label": "Label", "default": "How it works" },
  { "type": "text", "id": "heading", "label": "Heading" },
  { "type": "textarea", "id": "text", "label": "Paragraph", "default": "Each piece is agreed in conversation, then drawn, embroidered and fitted." }
], "blocks": [ { "type": "step", "name": "Step", "settings": [ { "type": "text", "id": "numeral", "label": "Numeral", "default": "I" }, { "type": "text", "id": "title", "label": "Title" }, { "type": "textarea", "id": "text", "label": "Text" } ] } ],
"presets": [ { "name": "AV Steps", "blocks": [
  { "type": "step", "settings": { "numeral": "I", "title": "The conversation", "text": "Write to us with the occasion and the date. Kamalam replies herself and, if the dates allow, we arrange a call or a studio visit." } },
  { "type": "step", "settings": { "numeral": "II", "title": "Cloth and design", "text": "You choose the cloth from our range. Kamalam draws the design for your occasion and sends it to you. Nothing goes to the frame until you approve it." } },
  { "type": "step", "settings": { "numeral": "III", "title": "The embroidery", "text": "Your piece is embroidered by hand in our Chennai studio. The kurta or shirt is cut to your measure. We tell you when the embroidery begins." } },
  { "type": "step", "settings": { "numeral": "IV", "title": "Fitting and delivery", "text": "One fitting, in Chennai or by measurement. Your piece is then sent to you by insured courier." } }
] } ] }
{% endschema %}
