{%- comment -%}
  Foot of the Story panel. Open stages: a red band of two routes, "See the looks" and "See the pieces".
  Teaser and reveal stages: a red band with the opening date and the notify sign-up (the newsletter form, tagged with
  the collection so the list can be split later). Routes to a locked tab are left out.
{%- endcomment -%}
{%- liquid
  assign series = metaobject | default: section.settings.series
  assign stage = series.status.value | default: 'current' | downcase | strip
  assign col = series.collection.value
  assign opens = ''
  if series.opens_on.value != blank
    assign opens = series.opens_on.value | date: '%-d %B'
  endif
  assign padded = series.number.value | prepend: '00' | slice: -3, 3
  assign padded_label = 'Collection ' | append: padded
  assign name = series.name.value | default: padded_label
  assign pieces_open = true
  if stage == 'teaser' or stage == 'reveal' or col == blank or col.products_count == 0
    assign pieces_open = false
  endif
-%}
{%- if series != blank -%}
<section class="av-series-onward" data-av-panel="story">
  {%- if pieces_open -%}
    <div class="av-series-onward__routes">
      {%- if series.looks.value.count > 0 -%}<a href="#looks" data-av-tab="looks"><span class="av-label av-label--light">02</span><span class="av-statement av-statement--m">See the looks</span></a>{%- endif -%}
      <a href="{{ col.url }}"><span class="av-label av-label--light">03</span><span class="av-statement av-statement--m">See the pieces</span></a>
    </div>
  {%- else -%}
    <div class="av-band av-series-onward__notify">
      <div class="av-stack" style="gap:10px">
        <div class="av-label">{% if opens != blank %}The pieces open {{ opens }}{% else %}The pieces open soon{% endif %}</div>
        <p class="av-statement av-statement--m">Be told when {{ name | escape }} opens.</p>
      </div>
      {% render 'av-newsletter-form', id: section.id, placeholder: 'Your email', class: 'av-footer__news av-series-onward__form' %}
      {%- if stage == 'reveal' and series.looks.value.count > 0 -%}<a class="av-link av-link--light" href="#looks" data-av-tab="looks">See the looks</a>{%- endif -%}
    </div>
  {%- endif -%}
</section>
{%- endif -%}
{% schema %}
{ "name": "AV Series onward", "settings": [
  { "type": "metaobject", "metaobject_type": "collection_meta", "id": "series", "label": "Collection (only for previewing outside a series page)" }
], "presets": [{ "name": "AV Series onward" }] }
{% endschema %}
