<footer class="av-footer">
  <div class="av-footer__grid">
    <div class="av-footer__brand">
      <img class="av-footer__symbol" src="{{ 'av-symbol-ivory.svg' | asset_url }}" alt="" width="1001" height="674" loading="lazy">
      {% render 'av-wordmark', class: 'av-footer__wordmark' %}
      <p class="av-footer__blurb">{{ section.settings.blurb | escape | newline_to_br }}</p>
      {% render 'av-newsletter-form', id: 'footer', placeholder: section.settings.news_placeholder, class: 'av-footer__news' %}
    </div>
    {%- for block in section.blocks -%}
      <div class="av-footer__col" {{ block.shopify_attributes }}>
        {%- comment -%} Column headings are not shown (23 Nov 2026); they stay for screen readers. {%- endcomment -%}
        <p class="visually-hidden">{{ block.settings.heading | escape }}</p>
        {%- if block.settings.menu.links.size > 0 -%}
          {%- for link in block.settings.menu.links -%}{%- if link.type == 'blog_link' and link.object.articles_count == 0 -%}{%- continue -%}{%- endif -%}<a href="{{ link.url }}">{{ link.title | escape }}</a>{%- endfor -%}
        {%- elsif block.settings.fallback != 'none' -%}
          {% render 'av-nav-fallback', group: block.settings.fallback %}
        {%- endif -%}
        {%- if block.settings.fallback == 'contact' -%}
          {%- assign menu_text = block.settings.menu.links | map: 'url' | join: ' ' -%}
          {%- if block.settings.menu.links.size > 0 and settings.social_instagram_link != blank -%}{%- unless menu_text contains 'instagram' -%}<a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener">Instagram</a>{%- endunless -%}{%- endif -%}
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
  {%- comment -%} The studio's details sit in their own row under the link columns (16 Nov 2026): the Contact column had become crowded. {%- endcomment -%}
  {%- liquid
    assign wa = settings.av_whatsapp_number | strip
    assign wa_shown = '+' | append: wa
    if wa.size == 12
      assign wa_cc = wa | slice: 0, 2
      assign wa_a = wa | slice: 2, 5
      assign wa_b = wa | slice: 7, 5
      assign wa_shown = '+' | append: wa_cc | append: ' ' | append: wa_a | append: ' ' | append: wa_b
    endif
  -%}
  <div class="av-footer__studio">
    {%- if settings.av_contact_address != blank -%}
    <div class="av-footer__studio-item">
      <p class="av-footer__title">Studio</p>
      <p>{{ settings.av_contact_address | escape | newline_to_br }}</p>
      <p>Visits by appointment.</p>
    </div>
    {%- endif -%}
    <div class="av-footer__studio-item">
      <p class="av-footer__title">Call or message</p>
      {% render 'av-phone-link', prefix: 'Phone ', class: 'av-footer__studio-link' %}
      {%- if wa != blank -%}<a class="av-footer__studio-link" href="https://wa.me/{{ wa }}" target="_blank" rel="noopener">WhatsApp {{ wa_shown }}</a>{%- endif -%}
    </div>
    <div class="av-footer__studio-item">
      <p class="av-footer__title">Email and hours</p>
      {%- if shop.email != blank -%}<a class="av-footer__studio-link" href="mailto:{{ shop.email }}">{{ shop.email }}</a>{%- endif -%}
      {%- if settings.av_contact_hours != blank -%}<p>{{ settings.av_contact_hours | escape }}</p>{%- endif -%}
    </div>
  </div>
  <div class="av-footer__bottom">
    <div>© {{ 'now' | date: '%Y' }} {{ shop.name | escape }}{% if shop.privacy_policy.body != blank %} · <a href="{{ shop.privacy_policy.url }}">{{ shop.privacy_policy.title | escape }}</a>{% endif %}{% if shop.terms_of_service.body != blank %} · <a href="{{ shop.terms_of_service.url }}">{{ shop.terms_of_service.title | escape }}</a>{% endif %}{% if shop.contact_information.body != blank %} · <a href="{{ shop.contact_information.url }}">{{ shop.contact_information.title | escape }}</a>{% endif %}</div>
    {%- if settings.av_usd_rate > 0 -%}
    <div class="av-currency" data-av-currency data-rate="{{ settings.av_usd_rate }}" role="group" aria-label="Show prices in">
      <button type="button" data-av-cur="INR" aria-pressed="true">INR ₹</button><span aria-hidden="true">/</span><button type="button" data-av-cur="USD" aria-pressed="false">USD $</button>
    </div>
    {%- else -%}
    <div>{{ settings.av_currency_line | escape }}</div>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "AV Footer",
  "limit": 1,
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    { "type": "textarea", "id": "blurb", "label": "Blurb", "default": "Handcrafted in Tamil Nadu.\nMenswear designed and embroidered by hand in our Chennai studio, on handloom cloth." },
    { "type": "text", "id": "news_placeholder", "label": "Newsletter placeholder", "default": "Your email address" }
  ],
  "blocks": [
    { "type": "column", "name": "Link column", "limit": 4, "settings": [
      { "type": "text", "id": "heading", "label": "Heading" },
      { "type": "link_list", "id": "menu", "label": "Menu" },
      { "type": "select", "id": "fallback", "label": "Built-in links when no menu is chosen", "options": [
        { "value": "none", "label": "None" },
        { "value": "house", "label": "The house (Stories · Gallery · About)" },
        { "value": "shop", "label": "Shop (Collections · Products · Commissions)" },
        { "value": "orders", "label": "Orders (shipping, returns, care, size)" },
        { "value": "contact", "label": "Contact (write, WhatsApp, Instagram, visit)" }
      ], "default": "none" }
    ] }
  ]
}
{% endschema %}
