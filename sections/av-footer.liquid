<footer class="av-footer">
  <div class="av-footer__grid">
    <div class="av-footer__brand">
      <img class="av-footer__symbol" src="{{ 'av-symbol-ivory.svg' | asset_url }}" alt="" width="792" height="487" loading="lazy">
      {% render 'av-wordmark', class: 'av-footer__wordmark' %}
      <p class="av-footer__blurb">{{ section.settings.blurb | escape | newline_to_br }}</p>
      {% render 'av-newsletter-form', id: 'footer', placeholder: section.settings.news_placeholder, class: 'av-footer__news' %}
    </div>
    {%- for block in section.blocks -%}
      <div class="av-footer__col" {{ block.shopify_attributes }}>
        <p class="av-label av-footer__title">{{ block.settings.heading | escape }}</p>
        {%- if block.settings.menu.links.size > 0 -%}
          {%- for link in block.settings.menu.links -%}{%- if link.type == 'blog_link' and link.object.articles_count == 0 -%}{%- continue -%}{%- endif -%}<a href="{{ link.url }}">{{ link.title | escape }}</a>{%- endfor -%}
        {%- elsif block.settings.fallback != 'none' -%}
          {% render 'av-nav-fallback', group: block.settings.fallback %}
        {%- endif -%}
        {%- if block.settings.fallback == 'contact' -%}
          {%- assign menu_text = block.settings.menu.links | map: 'url' | join: ' ' -%}
          {%- if block.settings.menu.links.size > 0 and settings.social_instagram_link != blank -%}{%- unless menu_text contains 'instagram' -%}<a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener">Instagram</a>{%- endunless -%}{%- endif -%}
          {% render 'av-contact-details', class: 'av-footer__details' %}
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
  <div class="av-footer__bottom">
    <div>© {{ 'now' | date: '%Y' }} {{ shop.name | escape }}{% if shop.privacy_policy.body != blank %} · <a href="{{ shop.privacy_policy.url }}">{{ shop.privacy_policy.title | escape }}</a>{% endif %}{% if shop.terms_of_service.body != blank %} · <a href="{{ shop.terms_of_service.url }}">{{ shop.terms_of_service.title | escape }}</a>{% endif %}{% if shop.contact_information.body != blank %} · <a href="{{ shop.contact_information.url }}">{{ shop.contact_information.title | escape }}</a>{% endif %}</div>
    <div>{{ settings.av_currency_line | escape }}</div>
  </div>
</footer>

{% schema %}
{
  "name": "AV Footer",
  "limit": 1,
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    { "type": "textarea", "id": "blurb", "label": "Blurb", "default": "Menswear, handcrafted in Tamil Nadu. Everyday and Occasional pieces in limited number; commissions made to order." },
    { "type": "text", "id": "news_placeholder", "label": "Newsletter placeholder", "default": "Your email, for the next collection" }
  ],
  "blocks": [
    { "type": "column", "name": "Link column", "limit": 4, "settings": [
      { "type": "text", "id": "heading", "label": "Heading" },
      { "type": "link_list", "id": "menu", "label": "Menu" },
      { "type": "select", "id": "fallback", "label": "Built-in links when no menu is chosen", "options": [
        { "value": "none", "label": "None" },
        { "value": "house", "label": "The house (Stories · Gallery · About)" },
        { "value": "shop", "label": "Shop (Collections · Products · Commissions)" },
        { "value": "orders", "label": "Orders (shipping, returns, care, size)" },
        { "value": "contact", "label": "Contact (write, WhatsApp, Instagram, visit)" }
      ], "default": "none" }
    ] }
  ]
}
{% endschema %}
