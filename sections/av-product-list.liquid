{%- comment -%}
  Products page list: available pieces first, then sold-out, within each page of 50.
  Renders on /collections/all (Shopify's automatic collection, default template) and on any collection using the products-all template.
{%- endcomment -%}
{%- if collection.handle == 'all' or template.suffix == 'products-all' -%}
<section class="av-list av-reveal">
  <h2 class="visually-hidden">Pieces</h2>
  {%- paginate collection.products by 50 -%}
    {%- if collection.products.size == 0 -%}
      <p class="av-body av-list__empty">{% if current_tags %}No pieces in this tier yet.{% else %}No pieces yet.{% endif %}</p>
    {%- else -%}
      <ul class="av-list__items">
        {%- for product in collection.products -%}
          {%- liquid
            assign fv = product.variants.first
            assign q = fv.inventory_quantity | default: 0
          -%}
          {%- if fv.inventory_management != 'shopify' or q > 0 -%}{% render 'av-product-list-item', product: product %}{%- endif -%}
        {%- endfor -%}
        {%- for product in collection.products -%}
          {%- liquid
            assign fv = product.variants.first
            assign q = fv.inventory_quantity | default: 0
          -%}
          {%- if fv.inventory_management == 'shopify' and q <= 0 -%}{% render 'av-product-list-item', product: product %}{%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
    {%- if paginate.pages > 1 -%}<nav class="av-list__pages" aria-label="Pagination">{{ paginate | default_pagination }}</nav>{%- endif -%}
  {%- endpaginate -%}
</section>
{%- endif -%}
{% schema %}
{ "name": "AV Product list", "settings": [] }
{% endschema %}
