{%- comment -%}
  Products page grid (rows and columns): available pieces first, then sold-out, within each page of 50. Sold out is av-edition-line's rule (context 'state').
  Renders on /collections/all (Shopify's automatic collection, default template) and on any collection using the products-all template.
  Only pieces that belong to a named collection (one with a collection_meta entry: Mullai, Kovil …) are listed; a product
  in no collection stays reachable by its own URL but is not shown here.
{%- endcomment -%}
{%- if collection.handle == 'all' or template.suffix == 'products-all' -%}
{%- liquid
  assign named_ids = ''
  for m in shop.metaobjects.collection_meta.values
    assign cid = m.collection.value.id
    if cid != blank
      assign named_ids = named_ids | append: ',' | append: cid | append: ','
    endif
  endfor
-%}
<section class="av-list">
  <h2 class="visually-hidden">Pieces</h2>
  {%- paginate collection.products by 50 -%}
    {%- liquid
      assign shown = 0
      for product in collection.products
        assign in_named = false
        for c in product.collections
          assign key = ',' | append: c.id | append: ','
          if named_ids contains key
            assign in_named = true
            break
          endif
        endfor
        if in_named
          assign shown = shown | plus: 1
        endif
      endfor
    -%}
    {%- if shown == 0 -%}
      <p class="av-body av-list__empty">{% if current_tags %}No pieces in this tier yet.{% else %}No pieces yet.{% endif %}</p>
    {%- else -%}
      <ul class="av-list__items">
        {%- for product in collection.products -%}
          {%- render 'av-product-list-pick', product: product, named_ids: named_ids, want: 'open' -%}
        {%- endfor -%}
        {%- for product in collection.products -%}
          {%- render 'av-product-list-pick', product: product, named_ids: named_ids, want: 'sold' -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
    {%- if paginate.pages > 1 -%}<nav class="av-list__pages" aria-label="Pagination">{{ paginate | default_pagination }}</nav>{%- endif -%}
  {%- endpaginate -%}
</section>
{%- endif -%}
{% schema %}
{ "name": "AV Product list", "settings": [] }
{% endschema %}
