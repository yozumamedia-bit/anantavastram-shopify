{%- comment -%}
  Top of the series page: header, tabs, then the opening photograph (the entry's ensemble image) or, failing that, its film.
  Reads the page's metaobject (templates/metaobject/collection_meta.json). The opening belongs to the Story panel.
{%- endcomment -%}
{%- liquid
  assign series = metaobject
  if series == blank and section.settings.series != blank
    assign series = section.settings.series
  endif
-%}
{%- if series != blank -%}
  <div class="av-series" data-av-series>
    {% render 'av-series-head', series: series, active: 'story' %}
    {%- if section.settings.show_opening -%}
      <div class="av-series-opening" data-av-panel="story" id="story">
        {%- if series.ensemble_image.value != blank -%}
          {% render 'av-media', image: series.ensemble_image.value, ratio: '1440 / 640', sizes: '100vw', loading: 'eager', priority: true, class: 'av-series-opening__media' %}
        {%- elsif series.film.value != blank -%}
          {% render 'av-video', loop_video: series.film.value, class: 'av-series-opening__media', reveal: false %}
        {%- endif -%}
      </div>
    {%- else -%}
      <span id="story"></span>
    {%- endif -%}
  </div>
  <script src="{{ 'av-series.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
{% schema %}
{ "name": "AV Series header", "settings": [
  { "type": "metaobject", "metaobject_type": "collection_meta", "id": "series", "label": "Collection (only for previewing outside a series page)" },
  { "type": "checkbox", "id": "show_opening", "label": "Show the opening photograph", "default": true, "info": "The collection's ensemble image; its film when there is no image." }
], "presets": [{ "name": "AV Series header" }] }
{% endschema %}
