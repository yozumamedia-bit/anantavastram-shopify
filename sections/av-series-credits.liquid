{%- comment -%}
  Story panel: the credits strip. The entry's `credits` field holds one line per credit, written "Role: names"
  (e.g. "Photography: Memory Lane Studios"). A line without a colon prints with an empty label.
{%- endcomment -%}
{%- assign series = metaobject | default: section.settings.series -%}
{%- if series != blank and series.credits.value != blank -%}
  {%- assign lines = series.credits.value | newline_to_br | split: '<br />' -%}
<section class="av-series-credits av-wrap" data-av-panel="story">
  <h2 class="visually-hidden">Credits</h2>
  <dl class="av-series-credits__list">
    {%- for line in lines -%}
      {%- assign l = line | strip -%}
      {%- if l == blank -%}{%- continue -%}{%- endif -%}
      {%- if l contains ':' -%}
        {%- assign role = l | split: ':' | first | strip -%}
        {%- assign who = l | remove_first: role | remove_first: ':' | strip -%}
      {%- else -%}
        {%- assign role = '' -%}
        {%- assign who = l -%}
      {%- endif -%}
      <div><dt class="av-label">{{ role | escape }}</dt><dd class="av-body av-body--s">{{ who | escape }}</dd></div>
    {%- endfor -%}
  </dl>
</section>
{%- endif -%}
{% schema %}
{ "name": "AV Series credits", "settings": [
  { "type": "metaobject", "metaobject_type": "collection_meta", "id": "series", "label": "Collection (only for previewing outside a series page)" }
], "presets": [{ "name": "AV Series credits" }] }
{% endschema %}
