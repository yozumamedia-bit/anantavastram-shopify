{%- comment -%}
  Commissions band on the homepage. Not a product row: an eyebrow, one full-bleed image, a Light statement,
  one paragraph and two links (the Commissions page, and a studio visit on WhatsApp). No price, no availability, no shipping line.
{%- endcomment -%}
<section class="av-commissions">
  <div class="av-commissions__head"><span class="av-label">{{ section.settings.label | escape }}</span></div>
  {% render 'av-media', image: section.settings.image, ratio: '16 / 7', sizes: '100vw', class: 'av-commissions__image' %}
  <div class="av-commissions__text">
    <h2 class="av-statement av-statement--l av-commissions__statement">{{ section.settings.statement | escape }}</h2>
    {%- if section.settings.routing != blank -%}<p class="av-body av-body--s av-commissions__routing">{{ section.settings.routing | escape }}</p>{%- endif -%}
    <div class="av-commissions__links">
      <a class="av-link" href="{{ section.settings.link }}">Begin a commission</a>
      {% render 'av-whatsapp-link', label: 'Book a studio visit', text: 'I would like to book a studio visit', class: 'av-link' %}
    </div>
  </div>
</section>
{% schema %}
{ "name": "AV Commissions band", "settings": [
  { "type": "text", "id": "label", "label": "Eyebrow", "default": "Commissions · Made to order" },
  { "type": "image_picker", "id": "image", "label": "Image (full bleed)" },
  { "type": "textarea", "id": "statement", "label": "Statement (General Sans Light)", "default": "One piece, for one person, made once." },
  { "type": "textarea", "id": "routing", "label": "Paragraph", "default": "A commission is a piece that does not exist yet. It begins with a conversation and is finalised in our Chennai studio." },
  { "type": "url", "id": "link", "label": "Link to Commissions page" }
], "presets": [{ "name": "AV Commissions band" }] }
{% endschema %}
