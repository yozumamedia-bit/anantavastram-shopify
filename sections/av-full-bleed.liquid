<section class="av-bleed" style="--av-bleed-y: {{ section.settings.focus_y | default: 50 }}%;">
  {% render 'av-media', image: section.settings.image, ratio: '1440 / 820', natural: section.settings.natural, sizes: '100vw' %}
  {%- if section.settings.left != blank or section.settings.right != blank -%}
  <div class="av-bleed__caption av-caption"><span class="av-body av-body--meta">{{ section.settings.left | escape }}</span><span class="av-body av-body--meta">{{ section.settings.right | escape }}</span></div>
  {%- endif -%}
</section>
{% schema %}
{ "name": "AV Full-bleed image", "settings": [
  { "type": "image_picker", "id": "image", "label": "Image" },
  { "type": "checkbox", "id": "natural", "label": "Show the whole photograph (no crop)", "default": false },
  { "type": "range", "id": "focus_y", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 50, "label": "Vertical focus", "info": "On a wide screen the photograph fills the page width and is trimmed above and below. This keeps the part that matters in the middle: 0 = top, 100 = bottom." },
  { "type": "text", "id": "left", "label": "Caption left" },
  { "type": "text", "id": "right", "label": "Caption right" }
], "presets": [{ "name": "AV Full-bleed image" }] }
{% endschema %}
