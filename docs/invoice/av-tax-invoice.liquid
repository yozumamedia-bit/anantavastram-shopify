{%- comment -%}
  Ananta Vastram · tax invoice (A4, prints on white paper).
  For the Shopify Order Printer app (Apps → Order Printer → Templates → Add template, paste this whole file),
  or any GST invoice app that takes a Liquid / HTML template.
  The logo (nautilus and wordmark) is the file av-logo-invoice.svg in the store's Files.
  Fill in the details below once. Tax names, rates and amounts are read from the order, as Shopify calculated them.
  HSN is read from the piece's metafield custom.hsn.
{%- endcomment -%}
{%- liquid
  assign seller_legal_name = '[Legal name of the business]'
  assign seller_gstin = '[GSTIN]'
  assign seller_state = 'Tamil Nadu (33)'
  assign seller_address = '6, 3rd Street, 3rd Floor, Abiramapuram, Chennai 600018, Tamil Nadu, India'
  assign seller_phone = '+91 99623 00009'
  assign seller_whatsapp = '+91 98400 02288'
  assign o = order
  assign bill = o.billing_address | default: o.shipping_address
  assign ship = o.shipping_address | default: o.billing_address
-%}
<style>
  @font-face { font-family: "General Sans"; font-weight: 300; src: url("https://anantavastram.com/cdn/shop/t/4/assets/general-sans-300.woff2") format("woff2"); }
  @font-face { font-family: "General Sans"; font-weight: 500; src: url("https://anantavastram.com/cdn/shop/t/4/assets/general-sans-500.woff2") format("woff2"); }
  @page { size: A4; margin: 18mm 18mm 16mm; }
  .inv, .inv * { box-sizing: border-box; }
  .inv { --kumkum: #9E1B1E; --ink: #2B2826; --grey: #7A746E; --line: #E4DED3; font-family: "General Sans", "Helvetica Neue", Helvetica, Arial, sans-serif; font-weight: 300; font-size: 9.5pt; line-height: 1.55; color: var(--ink); max-width: 174mm; margin: 0 auto; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  .inv p { margin: 0; }
  .inv-label { font-size: 7pt; letter-spacing: 0.16em; text-transform: uppercase; color: var(--grey); margin-bottom: 6px; }
  .inv-strong { font-weight: 500; }

  /* header: wordmark left, document title and its numbers right */
  .inv-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 24px; }
  .inv-logo { display: block; width: 78mm; height: auto; }
  .inv-doc { text-align: right; }
  .inv-title { font-size: 9pt; letter-spacing: 0.2em; text-transform: uppercase; color: var(--kumkum); font-weight: 500; }
  .inv-facts { margin-top: 10px; border-collapse: collapse; margin-left: auto; }
  .inv-facts td { padding: 1px 0 1px 18px; text-align: right; }
  .inv-facts td:first-child { color: var(--grey); padding-left: 0; }

  /* who it is for */
  .inv-parties { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 16mm; padding-top: 14px; border-top: 1px solid var(--ink); }

  /* the pieces */
  .inv-items { width: 100%; border-collapse: collapse; margin-top: 14mm; }
  .inv-items th { font-weight: 300; font-size: 7pt; letter-spacing: 0.16em; text-transform: uppercase; color: var(--grey); text-align: left; padding: 0 0 8px; border-bottom: 1px solid var(--ink); }
  .inv-items td { padding: 14px 0; border-bottom: 1px solid var(--line); vertical-align: top; }
  .inv .num { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .inv-piece { font-weight: 500; font-size: 10.5pt; }
  .inv-sub { color: var(--grey); font-size: 8.5pt; }

  /* totals, right-hand column only */
  .inv-totals { width: 70mm; margin: 10px 0 0 auto; border-collapse: collapse; }
  .inv-totals td { padding: 5px 0; }
  .inv-totals td:first-child { color: var(--grey); }
  .inv-totals tr.total td { border-top: 1px solid var(--ink); padding-top: 12px; font-size: 12pt; font-weight: 500; color: var(--ink); }
  .inv-totals tr.total td:last-child { color: var(--kumkum); }
  .inv-totals tr.pre-total td { padding-bottom: 12px; }

  /* signature and the small print */
  .inv-sign { margin: 16mm 0 0 auto; width: 70mm; text-align: right; font-size: 8.5pt; color: var(--grey); break-inside: avoid; }
  .inv-sign__line { margin-top: 16mm; border-top: 1px solid var(--ink); padding-top: 6px; }
  .inv-small { margin-top: 14mm; padding-top: 12px; border-top: 1px solid var(--line); display: grid; grid-template-columns: 1fr 1fr; gap: 24px; font-size: 8pt; line-height: 1.6; color: var(--grey); break-inside: avoid; }
  .inv-small .inv-label { margin-bottom: 4px; }
</style>

<div class="inv">
  <div class="inv-top">
    <img class="inv-logo" src="https://cdn.shopify.com/s/files/1/0827/6918/2944/files/av-logo-invoice.svg?v=1794971988" alt="Ananta Vastram">
    <div class="inv-doc">
      <div class="inv-title">Tax invoice</div>
      <table class="inv-facts">
        <tr><td>Invoice no.</td><td class="inv-strong">{{ o.name | default: o.order_name }}</td></tr>
        <tr><td>Date</td><td>{{ o.created_at | date: "%-d %B %Y" }}</td></tr>
        <tr><td>Place of supply</td><td>{{ ship.province | default: ship.country }}</td></tr>
        <tr><td>Payment</td><td>{{ o.financial_status | default: 'pending' | replace: '_', ' ' | capitalize }}</td></tr>
      </table>
    </div>
  </div>

  <div class="inv-parties">
    <div>
      <div class="inv-label">Billed to</div>
      <p class="inv-strong">{{ bill.name }}</p>
      {%- if bill.company != blank -%}<p>{{ bill.company }}</p>{%- endif -%}
      <p>{{ bill.address1 }}{% if bill.address2 != blank %}, {{ bill.address2 }}{% endif %}</p>
      <p>{{ bill.city }} {{ bill.zip }}{% if bill.province != blank %}, {{ bill.province }}{% endif %}</p>
      <p>{{ bill.country }}</p>
      {%- if bill.phone != blank -%}<p>{{ bill.phone }}</p>{%- endif -%}
    </div>
    <div>
      <div class="inv-label">Shipped to</div>
      <p class="inv-strong">{{ ship.name }}</p>
      <p>{{ ship.address1 }}{% if ship.address2 != blank %}, {{ ship.address2 }}{% endif %}</p>
      <p>{{ ship.city }} {{ ship.zip }}{% if ship.province != blank %}, {{ ship.province }}{% endif %}</p>
      <p>{{ ship.country }}</p>
      {%- if ship.phone != blank -%}<p>{{ ship.phone }}</p>{%- endif -%}
    </div>
  </div>

  <table class="inv-items">
    <thead>
      <tr>
        <th>Description</th>
        <th style="width:24mm">HSN</th>
        <th class="num" style="width:14mm">Qty</th>
        <th class="num" style="width:30mm">Rate</th>
        <th class="num" style="width:32mm">Amount</th>
      </tr>
    </thead>
    <tbody>
      {%- for line_item in o.line_items -%}
        {%- assign hsn = line_item.product.metafields.custom.hsn.value | default: line_item.product.metafields.custom.hsn | default: line_item.variant.harmonized_system_code -%}
        <tr>
          <td>
            <div class="inv-piece">{{ line_item.title }}</div>
            {%- if line_item.variant_title != blank and line_item.variant_title != 'Default Title' -%}<div class="inv-sub">{{ line_item.variant_title }}</div>{%- endif -%}
            {%- if line_item.sku != blank -%}<div class="inv-sub">{{ line_item.sku }}</div>{%- endif -%}
          </td>
          <td>{{ hsn | default: '&nbsp;' }}</td>
          <td class="num">{{ line_item.quantity }}</td>
          <td class="num">{{ line_item.final_price | default: line_item.price | money }}</td>
          <td class="num">{{ line_item.final_line_price | default: line_item.line_price | money }}</td>
        </tr>
      {%- endfor -%}
    </tbody>
  </table>

  <table class="inv-totals">
    <tr><td>Subtotal</td><td class="num">{{ o.subtotal_price | money }}</td></tr>
    <tr><td>Shipping</td><td class="num">{% if o.shipping_price == blank or o.shipping_price == 0 %}Free{% else %}{{ o.shipping_price | money }}{% endif %}</td></tr>
    {%- for tax_line in o.tax_lines -%}
      <tr{% if forloop.last %} class="pre-total"{% endif %}><td>{{ tax_line.title }} {{ tax_line.rate | times: 100 | round: 2 }}%{% if o.taxes_included %}, included{% endif %}</td><td class="num">{{ tax_line.price | money }}</td></tr>
    {%- endfor -%}
    <tr class="total"><td>Total</td><td class="num">{{ o.total_price | money }}</td></tr>
    {%- if o.total_outstanding != blank and o.total_outstanding != 0 -%}
      <tr><td>Balance due</td><td class="num">{{ o.total_outstanding | money }}</td></tr>
    {%- endif -%}
  </table>

  <div class="inv-sign">
    <div>For {{ seller_legal_name }}</div>
    <div class="inv-sign__line">Authorised signatory</div>
  </div>

  <div class="inv-small">
    <div>
      <div class="inv-label">Sold by</div>
      <p>{{ seller_legal_name }}</p>
      <p>{{ seller_address }}</p>
      <p>GSTIN {{ seller_gstin }} · State {{ seller_state }}</p>
      <p>{{ seller_phone }} · {{ shop.email }}</p>
    </div>
    <div>
      <div class="inv-label">Terms</div>
      <p>If your piece arrives damaged, write to us within 48 hours with photographs. Commissions are made for one person and cannot be returned.</p>
      {%- if o.note != blank -%}<p>{{ o.note }}</p>{%- endif -%}
    </div>
  </div>
</div>
