{%- comment -%}
  The one source of the availability rule. Usage: {% render 'av-edition-line', product: product, context: 'tile' %}

  Two kinds of piece (product metafield custom.tier):
    everyday / occasional — held in stock, in limited number. What remains is Shopify inventory: track quantity ON,
                            "Continue selling when out of stock" OFF. A piece at 0 is sold out and stays listed as the
                            record. custom.edition_total (optional) is how many were ever made: "3 of 8 remain".
    commission            — made to order after a conversation. No price, no order button, never counted.

  context:
    state:     sold | enquiry | open | soon — callers branch on it: {% capture state %}{% render … context: 'state' %}{% endcapture %}
    tile:      "3 of 8 remain" / "3 remain" / "In stock" / "Sold out" / "Made to order"   (tiles, lists, look panels)
    row:       "Edition of 8. 3 remain." / "Edition of 8. Sold out."   (only when edition_total is set)
    page:      "3 of 8 remain" / "Sold out"
    remaining: integer, pieces still in stock (0 for commission pieces) — the collection header sums it
    total:     integer, edition_total (0 when unset or for commission pieces) — summed next to it

  soon: before the opening. While the theme setting "Before the opening" (settings.av_opening_line, e.g. "Opens at
  Diwali") has text, every stocked piece shows that line in place of price, count and order button. A piece whose
  price is 0 is also 'soon', so a zero price never prints. Clear the setting on the opening day.
{%- endcomment -%}
{%- liquid
  assign v = product.selected_or_first_available_variant | default: product.variants.first
  assign tier = product.metafields.custom.tier.value | downcase | strip
  assign total = product.metafields.custom.edition_total.value | default: 0
  assign enquiry = false
  if tier == 'commission'
    assign enquiry = true
  endif
  assign sold = false
  assign tracked = false
  assign remaining = 0
  if enquiry
    assign total = 0
  else
    if v.inventory_management == 'shopify'
      assign tracked = true
      assign remaining = v.inventory_quantity | default: 0
    elsif v.available
      assign remaining = 1
    endif
    if v.available == false or tracked and remaining <= 0
      assign sold = true
      assign remaining = 0
    endif
  endif
  assign soon = false
  if enquiry == false
    if settings.av_opening_line != blank or v.price == 0
      assign soon = true
      assign sold = false
      if tracked
        assign remaining = v.inventory_quantity | default: 0
        if remaining < 0
          assign remaining = 0
        endif
      endif
    endif
  endif
  assign soon_line = settings.av_opening_line | default: 'Price to follow'
-%}
{%- case context -%}
{%- when 'state' -%}
  {%- if enquiry -%}enquiry{%- elsif soon -%}soon{%- elsif sold -%}sold{%- else -%}open{%- endif -%}
{%- when 'remaining' -%}
  {{- remaining -}}
{%- when 'total' -%}
  {{- total -}}
{%- when 'row' -%}
  {%- if total > 0 and enquiry == false -%}Edition of {{ total }}.{% if soon %}{% elsif sold %} Sold out.{% else %} {{ remaining }} remain.{% endif %}{%- endif -%}
{%- when 'page' -%}
  {%- if enquiry -%}Made to order{%- elsif soon -%}{{ soon_line | escape }}{%- elsif sold -%}Sold out{%- elsif tracked -%}{{ remaining }}{% if total > 0 %} of {{ total }}{% endif %} remain{%- else -%}In stock{%- endif -%}
{%- else -%}
  {%- if enquiry -%}Made to order{%- elsif soon -%}{{ soon_line | escape }}{%- elsif sold -%}Sold out{%- elsif tracked -%}{{ remaining }}{% if total > 0 %} of {{ total }}{% endif %} remain{%- else -%}In stock{%- endif -%}
{%- endcase -%}
