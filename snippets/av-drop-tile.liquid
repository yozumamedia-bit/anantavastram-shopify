{%- comment -%}
  Usage: {% render 'av-drop-tile', product: product %}
  Photograph, name, price, then numeral · line and what remains. Sold out dims the photograph only
  (CSS .av-tile--sold .av-media); the price goes once every piece is placed. A commission piece shows "On enquiry".
  Availability comes from snippets/av-edition-line.liquid (context 'state').
{%- endcomment -%}
{%- liquid
  capture state
    render 'av-edition-line', product: product, context: 'state'
  endcapture
  capture label
    render 'av-piece-label', product: product
  endcapture
-%}
<a class="av-tile{% if state contains 'sold' %} av-tile--sold{% endif %}" href="{{ product.url }}">
  {% render 'av-media', image: product.featured_image, alt_image: product.images[1], vt: product.handle, ratio: '3 / 4', sizes: '(min-width: 900px) 16vw, 50vw', alt: '' %}
  <span class="av-tile__text">
    <span class="av-name av-tile__name">{{ product.title | escape }}</span>
    {%- if state contains 'enquiry' -%}<span class="av-price av-tile__price">On enquiry</span>{%- elsif state contains 'open' -%}<span class="av-price av-tile__price">{{ product.price | money }}</span>{%- endif -%}
    <span class="av-tile__meta">
      {%- if label != blank -%}<span class="av-label">{{ label }}</span>{%- endif -%}
      <span class="av-tile__left">{% render 'av-edition-line', product: product, context: 'tile' %}</span>
    </span>
  </span>
</a>
