{%- comment -%} Floating WhatsApp button, bottom-right on every page. Off when the setting is off or no number is set. On a product page the opening message names the piece. {%- endcomment -%}
{%- if settings.av_whatsapp_float and settings.av_whatsapp_number != blank -%}
  {%- liquid
    assign text = 'Hello Ananta Vastram'
    if template.name == 'product' and product.title != blank
      assign text = 'About ' | append: product.title
    endif
  -%}
  {%- assign wa_class = 'av-wa-float' -%}
  {%- if template.name == 'index' -%}{%- assign wa_class = 'av-wa-float is-waiting' -%}{%- endif -%}
  {% render 'av-whatsapp-link', label: 'Write to us on WhatsApp', text: text, class: wa_class, icon: true %}
  {%- if template.name == 'index' -%}
  <script>(function(){var b=document.querySelector('.av-wa-float.is-waiting');if(!b)return;function go(){if(window.scrollY>120){b.classList.remove('is-waiting');window.removeEventListener('scroll',go);}}window.addEventListener('scroll',go,{passive:true});go();})();</script>
  {%- endif -%}
{%- endif -%}
