{%- comment -%} One product, one row. Usage: {% render 'av-product-row', product: product %} {%- endcomment -%}
{%- liquid
  assign mf = product.metafields.av
  assign weaver = mf.weaver.value
  assign v = product.selected_or_first_available_variant | default: product.variants.first
  assign sold_out = false
  if v.inventory_management == 'shopify' and v.inventory_quantity <= 0
    assign sold_out = true
  endif
  assign edition_total = mf.edition_total.value | default: 0
-%}
<article class="av-row av-reveal{% if sold_out %} av-row--sold{% endif %}">
  <a href="{{ product.url }}" aria-label="{{ product.title | escape }}">{% render 'av-media', image: product.featured_image, alt_image: product.images[1], ratio: '520 / 560', sizes: '(min-width: 1100px) 520px, (min-width: 900px) 50vw, 100vw' %}</a>
  <div class="av-row__story">
    <div class="av-stack" style="gap:8px">
      <div class="av-label">{% if mf.numeral.value != blank %}No. {{ mf.numeral.value | escape }}{% if mf.tier.value != blank %} · {% endif %}{% endif %}{% if mf.tier.value != blank %}{{ mf.tier.value | capitalize | escape }}{% endif %}</div>
      <h3 class="av-name"><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
    </div>
    <div class="av-body av-body--s">{{ product.description }}</div>
    {%- if mf.how_made.value != blank or weaver != blank -%}
    <div class="av-row__making">
      <div class="av-label av-label--red">How it is made</div>
      <div class="av-body av-body--s">
        {%- if weaver != blank -%}Woven by {{ weaver.name.value | escape }}{% if weaver.unit.value != blank %} at {{ weaver.unit.value | escape }}{% endif %}. {% endif -%}
        {{ mf.how_made.value | escape | newline_to_br }}
      </div>
    </div>
    {%- endif -%}
  </div>
  <div class="av-row__notes">
    {%- if sold_out -%}
      {%- comment -%} The row stays as the record of the edition; no price once it is complete. {%- endcomment -%}
      <div class="av-label av-label--red">{% if edition_total > 0 %}Edition of {{ edition_total }} · complete{% else %}Edition complete{% endif %}</div>
    {%- else -%}
      <div class="av-price">{{ product.price | money }}</div>
      {%- if settings.av_tax_line != blank -%}<div class="av-label av-price__note">{{ settings.av_tax_line | escape }}</div>{%- endif -%}
    {%- endif -%}
    {%- if edition_total > 0 -%}
    <div class="av-row__note"><div class="av-label">Edition</div><div class="av-body av-body--s">{% render 'av-edition-line', product: product, context: 'row' %}</div></div>
    {%- endif -%}
    <div class="av-row__note"><div class="av-label">Availability</div><div class="av-body av-body--s">{% if sold_out %}Sold out.{% else %}Made to order.{% if mf.lead_time_weeks.value != blank %} {{ mf.lead_time_weeks.value }} {% if mf.lead_time_weeks.value == 1 %}week{% else %}weeks{% endif %} from confirmation.{% endif %}{% endif %}</div></div>
    <div class="av-row__note"><div class="av-label">Shipping</div><div class="av-body av-body--s">{{ settings.av_shipping_line | escape }}</div></div>
    <a class="av-link" href="{{ product.url }}">View the piece</a>
  </div>
</article>
