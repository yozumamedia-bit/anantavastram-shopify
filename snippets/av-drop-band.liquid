{%- comment -%}
  One collection's band + its tile strip, on the Collections index. Usage: {% render 'av-drop-band', drop: entry, mode: 'open' %}
  drop: a collection_meta entry. mode: 'open' (large band — every collection not closed) | 'past' (compact band, closed).
  Before a collection opens (status teaser / reveal) the band shows the opening date. An open band names its pieces
  and carries one link, "See the collection"; no count of pieces and no stock figure is shown (copy draft 4, Nov 2026).
  Remaining is summed from snippets/av-edition-line.liquid (contexts 'remaining' and 'total'), as in av-coll-head.
{%- endcomment -%}
{%- liquid
  assign col = drop.collection.value
  assign stage = drop.status.value | default: 'open' | downcase | strip
  if stage == 'current'
    assign stage = 'open'
  endif
  assign remaining = 0
  assign total = 0
  for p in col.products
    capture r
      render 'av-edition-line', product: p, context: 'remaining'
    endcapture
    assign r = r | strip | plus: 0
    assign remaining = remaining | plus: r
    capture t
      render 'av-edition-line', product: p, context: 'total'
    endcapture
    assign t = t | strip | plus: 0
    assign total = total | plus: t
  endfor
  assign upcoming = false
  if stage == 'teaser' or stage == 'reveal'
    assign upcoming = true
  endif
  assign opens = ''
  if drop.opens_on.value != blank
    assign opens = drop.opens_on.value | date: '%-d %B'
  endif
  assign name = drop.name.value | default: col.title
  assign eyebrow = 'Collection'
  capture piece_names
    for p in col.products limit: 8
      unless forloop.first
        echo ' · '
      endunless
      echo p.title | escape
    endfor
  endcapture
-%}
{%- capture chip -%}
  {%- if upcoming -%}<span class="av-chip av-chip--outline">{% if opens != blank %}Opens {{ opens }}{% else %}Coming{% endif %}</span>
  {%- elsif stage == 'closed' -%}<span class="av-chip av-chip--outline av-chip--closed">Closed</span>
  {%- elsif total > 0 and remaining == 0 -%}<span class="av-chip av-chip--outline av-chip--closed">Sold out</span>
  {%- endif -%}
{%- endcapture -%}
{%- if mode == 'past' -%}
<section class="av-past">
  <div class="av-past__head">
    <div class="av-stack" style="gap:22px">
      <div class="av-drop__head"><span class="av-label">{{ eyebrow }}</span>{{ chip }}</div>
      <h3 class="av-sub av-sub--m">{{ name | escape }}</h3>
    </div>
    <div class="av-stack" style="max-width:620px">
      {%- if drop.story.value != blank -%}<div class="av-body">{% render 'av-field-text', field: drop.story %}</div>{%- endif -%}
      <a class="av-link" href="{{ col.url }}">See the collection</a>
    </div>
  </div>
  <div class="av-tiles">{%- for p in col.products limit: 6 -%}{% render 'av-drop-tile', product: p %}{%- endfor -%}</div>
</section>
{%- else -%}
<section class="av-drop">
  {% render 'av-media', image: drop.ensemble_image.value, ratio: '780 / 820', natural: true, sizes: '(min-width: 700px) 50vw, 100vw', loading: 'eager' %}
  <div class="av-drop__info">
    <div class="av-stack" style="gap:28px">
      <div class="av-drop__head"><span class="av-label">{{ eyebrow }}</span>{{ chip }}</div>
      <h2 class="av-sub av-sub--l">{{ name | escape }}</h2>
      {%- if drop.theme.value != blank -%}<p class="av-body av-drop__theme av-ta">{{ drop.theme.value | escape }}</p>{%- endif -%}
      {%- comment -%} The band carries the theme line only; the collection's story is on its own page. {%- endcomment -%}
      {%- unless upcoming -%}{%- if piece_names != blank -%}<p class="av-body av-body--s av-drop__pieces">{{ piece_names }}</p>{%- endif -%}{%- endunless -%}
    </div>
    <a class="av-link" href="{{ col.url }}">{% if upcoming %}Read the story{% else %}See the collection{% endif %}</a>
  </div>
</section>
{%- endif -%}
