{%- comment -%} One compact list row. Usage (inside a <ul class="av-list__items">): {% render 'av-product-list-item', product: product %}  Availability comes from snippets/av-edition-line.liquid (context 'state'); the label from av-piece-label (collection name · numeral · line). {%- endcomment -%}
{%- liquid
  capture state
    render 'av-edition-line', product: product, context: 'state'
  endcapture
  capture label
    render 'av-piece-label', product: product, with_collection: true
  endcapture
-%}
<li class="av-list__row">
  <a class="av-list__item{% if state contains 'sold' %} av-list__item--sold{% endif %}" href="{{ product.url }}">
    {% render 'av-media', image: product.featured_image, alt_image: product.images[1], vt: product.handle, ratio: '4 / 5', sizes: '(min-width: 900px) 160px, 96px', alt: '' %}
    <div class="av-list__name">
      {%- if label != blank -%}<span class="av-label">{{ label }}</span>{%- endif -%}
      <h3 class="av-name">{{ product.title | escape }}</h3>
    </div>
    <span class="av-list__left">{% render 'av-edition-line', product: product, context: 'tile' %}</span>
    <span class="av-price">{% if state contains 'enquiry' %}On enquiry{% elsif state contains 'open' %}{{ product.price | money }}{% endif %}</span>
  </a>
</li>
