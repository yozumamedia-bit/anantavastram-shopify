{%- comment -%} General Sans (Indian Type Foundry, Fontshare licence), self-hosted. Rendered inside the {% style %} block of theme.liquid and password.liquid. {%- endcomment -%}
@font-face { font-family: 'General Sans'; font-style: normal; font-weight: 300; font-display: swap; src: url('{{ 'general-sans-300.woff2' | asset_url }}') format('woff2'); }
@font-face { font-family: 'General Sans'; font-style: normal; font-weight: 500; font-display: swap; src: url('{{ 'general-sans-500.woff2' | asset_url }}') format('woff2'); }
@font-face { font-family: 'General Sans'; font-style: normal; font-weight: 700; font-display: swap; src: url('{{ 'general-sans-700.woff2' | asset_url }}') format('woff2'); }
@font-face { font-family: 'Noto Sans Tamil'; font-style: normal; font-weight: 300 700; font-display: swap; src: url('{{ 'noto-sans-tamil-300-700.woff2' | asset_url }}') format('woff2'); unicode-range: U+0964-0965, U+0B82-0BFA, U+200C-200D, U+20B9, U+25CC; } /* Tamil subset only (50 KB, variable 300–700, SIL OFL — assets/noto-sans-tamil-OFL.txt); used by .av-ta for motif names */
